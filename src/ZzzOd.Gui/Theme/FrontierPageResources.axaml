<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- FrontierShellWindow owns the SampleApp* page geometry used by the sole remaining page tree. -->
  <Thickness x:Key="SampleAppPageMargin">20 20 20 12</Thickness>
  <x:Double x:Key="SampleAppSectionSpacing">8</x:Double>
  <Thickness x:Key="SampleAppHeaderMargin">0 0 0 10</Thickness>
  <x:Double x:Key="SampleAppScrollBarSize">10</x:Double>
  <!-- FluentAvalonia 3.0.2 Fluentv2.axaml 与 SettingsExpanderStyles.axaml 的密度令牌。 -->
  <Thickness x:Key="SettingsExpanderPadding">12</Thickness>
  <x:Double x:Key="SettingsExpanderMinHeight">56</x:Double>
  <x:Double x:Key="SettingsExpanderItemMinHeight">44</x:Double>
  <!-- TabControlStyles.axaml 直接消费这些项目级令牌，选中指示条沿用 AccentFillColorDefaultBrush。 -->
  <x:Double x:Key="ZzzPivotHeaderFontSize">16</x:Double>
  <x:Double x:Key="ZzzPivotHeaderMinHeight">44</x:Double>
  <Thickness x:Key="ZzzPivotHeaderPadding">12 0</Thickness>
  <Thickness x:Key="ZzzPivotContentMargin">0 8 0 0</Thickness>
  <StaticResource x:Key="PivotHeaderItemSelectedPipeFill"
                  ResourceKey="AccentFillColorDefaultBrush" />
</ResourceDictionary>
