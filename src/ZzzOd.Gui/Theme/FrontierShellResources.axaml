<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ZzzFrontierWindowBackgroundBrush"
                   Color="{DynamicResource SolidBackgroundFillColorBase}" />
  <SolidColorBrush x:Key="ZzzFrontierTitleBarForegroundBrush"
                   Color="{DynamicResource TextFillColorPrimary}" />
</ResourceDictionary>
