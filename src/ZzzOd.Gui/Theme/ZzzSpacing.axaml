<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="ZzzSpacingXSmall">4</x:Double>
  <x:Double x:Key="ZzzSpacingSmall">8</x:Double>
  <x:Double x:Key="ZzzSpacingMedium">12</x:Double>
  <x:Double x:Key="ZzzSpacingLarge">16</x:Double>
  <x:Double x:Key="ZzzSpacingXLarge">24</x:Double>
  <x:Double x:Key="ZzzNavigationPaneWidth">72</x:Double>
  <x:Double x:Key="ZzzNavigationItemHeight">64</x:Double>
  <x:Double x:Key="ZzzTitleBarHeight">32</x:Double>
  <x:Double x:Key="ZzzWindowControlWidth">46</x:Double>
  <x:Double x:Key="ZzzIconCommandSize">36</x:Double>
  <x:Double x:Key="ZzzCommandHeight">34</x:Double>
  <x:Double x:Key="ZzzRunCommandMinHeight">40</x:Double>
  <x:Double x:Key="ZzzRunCommandSpacing">12</x:Double>
  <Thickness x:Key="ZzzRunCommandPadding">16,8</Thickness>
  <x:Double x:Key="ZzzListRowHeight">40</x:Double>
  <Thickness x:Key="ZzzShellContentMargin">11,32,11,0</Thickness>
  <Thickness x:Key="ZzzPagePadding">24</Thickness>
  <!-- Shared pages keep their classic defaults; FrontierShellWindow overrides these keys. -->
  <Thickness x:Key="SampleAppPageMargin">11</Thickness>
  <x:Double x:Key="SampleAppSectionSpacing">8</x:Double>
  <Thickness x:Key="SampleAppHeaderMargin">0,0,0,10</Thickness>
  <x:Double x:Key="SampleAppScrollBarSize">10</x:Double>
</ResourceDictionary>
