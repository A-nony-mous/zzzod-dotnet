<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:shell="using:ZzzOd.Gui.Shell"
        xmlns:ui="using:FluentAvalonia.UI.Controls">
  <Style Selector="TextBlock.zzz-page-title">
    <Setter Property="FontSize" Value="{DynamicResource ZzzFontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.zzz-caption">
    <Setter Property="FontSize" Value="{DynamicResource ZzzFontSizeCaption}" />
  </Style>
  <Style Selector="TextBlock.zzz-card-title">
    <Setter Property="FontSize" Value="{DynamicResource ZzzFontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.zzz-body">
    <Setter Property="FontSize" Value="{DynamicResource ZzzFontSizeBody}" />
  </Style>
  <Style Selector="ui|FAInfoBar.zzz-info-bar">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="ui|FANumberBox">
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="ui|FAComboBox">
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="Border.zzz-media-overlay">
    <Setter Property="Background" Value="{DynamicResource ZzzMediaOverlayBrush}" />
  </Style>
  <Style Selector="TextBlock.zzz-log-line">
    <Setter Property="FontSize" Value="{DynamicResource ZzzFontSizeCaption}" />
  </Style>
  <Style Selector="ui|FANavigationViewItem.zzz-navigation-item">
    <Setter Property="Width" Value="{DynamicResource ZzzNavigationPaneWidth}" />
    <Setter Property="Height" Value="{DynamicResource ZzzNavigationItemHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource ZzzNavigationItemHeight}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ui|FANavigationViewItem.zzz-navigation-item:selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- =============================== -->
  <!-- 视觉预设隔离结束 -->

  <Style Selector="TextBlock.zzz-titlebar-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Grid.zzz-titlebar.home-mode TextBlock.zzz-titlebar-title">
    <Setter Property="Foreground" Value="#E6ECF0F5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Effect">
      <DropShadowDirectionEffect Color="#CC000000"
                                 BlurRadius="1"
                                 ShadowDepth="1"
                                 Direction="315" />
    </Setter>
  </Style>
  <Style Selector="Button.zzz-titlebar-action">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.zzz-titlebar-action:pointerover">
    <Setter Property="Background" Value="#09000000" />
  </Style>
  <Style Selector="Button.zzz-titlebar-action:pressed">
    <Setter Property="Background" Value="#06000000" />
  </Style>
  <Style Selector="Grid.zzz-titlebar.home-mode Button.zzz-titlebar-action">
    <Setter Property="Foreground" Value="#E6ECF0F5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Effect">
      <DropShadowDirectionEffect Color="#CC000000"
                                 BlurRadius="1"
                                 ShadowDepth="1"
                                 Direction="315" />
    </Setter>
  </Style>
  <Style Selector="Grid.zzz-titlebar.home-mode Button.zzz-titlebar-action:pointerover">
    <Setter Property="Background" Value="#1EFFFFFF" />
  </Style>
  <Style Selector="Grid.zzz-titlebar.home-mode Button.zzz-titlebar-action:pressed">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.zzz-window-control">
    <Setter Property="Width" Value="{DynamicResource ZzzWindowControlWidth}" />
    <Setter Property="Height" Value="{DynamicResource ZzzTitleBarHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.zzz-window-control:pointerover">
    <Setter Property="Background" Value="#1A000000" />
  </Style>
  <Style Selector="Button.zzz-window-control:pressed">
    <Setter Property="Background" Value="#33000000" />
  </Style>
  <Style Selector="Grid.zzz-titlebar.home-mode Button.zzz-window-control">
    <Setter Property="Foreground" Value="#E6ECF0F5" />
    <Setter Property="Effect">
      <DropShadowDirectionEffect Color="#CC000000"
                                 BlurRadius="1"
                                 ShadowDepth="1"
                                 Direction="315" />
    </Setter>
  </Style>
  <Style Selector="Grid.zzz-titlebar.home-mode Button.zzz-window-control:pointerover">
    <Setter Property="Background" Value="#0DFFFFFF" />
  </Style>
  <Style Selector="Grid.zzz-titlebar.home-mode Button.zzz-window-control:pressed">
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>
  <Style Selector="Button.zzz-primary-command">
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="MinHeight" Value="{DynamicResource ZzzCommandHeight}" />
  </Style>
  <Style Selector="Button.zzz-secondary-command">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="MinHeight" Value="{DynamicResource ZzzCommandHeight}" />
  </Style>
  <Style Selector="Button.zzz-run-command">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="{DynamicResource ZzzRunCommandMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource ZzzRunCommandPadding}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.zzz-home-media-scrim">
    <Setter Property="Background" Value="{DynamicResource ZzzMediaOverlayBrush}" />
  </Style>
  <Style Selector="Button.zzz-home-start">
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="16,2,16,0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Background" Value="{DynamicResource ZzzHomeStartBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZzzHomeStartForegroundBrush}" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Effect">
      <DropShadowDirectionEffect Color="#8C000000"
                                 BlurRadius="24"
                                 ShadowDepth="6"
                                 Direction="270" />
    </Setter>
  </Style>
  <Style Selector="Button.zzz-home-icon-button">
    <Setter Property="Width" Value="54" />
    <Setter Property="Height" Value="54" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Effect">
      <DropShadowEffect Color="#FF000000"
                        BlurRadius="5"
                        OffsetX="0"
                        OffsetY="0" />
    </Setter>
  </Style>
  <Style Selector="Button.zzz-home-icon-button:pointerover">
    <Setter Property="Background" Value="#26FFFFFF" />
  </Style>
  <Style Selector="Button.zzz-home-icon-button:pressed">
    <Setter Property="Background" Value="#38FFFFFF" />
  </Style>
  <Style Selector="Border.zzz-notice-card">
    <Setter Property="Background" Value="{DynamicResource ZzzNoticeSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Effect">
      <DropShadowDirectionEffect Color="#96000000"
                                 BlurRadius="28"
                                 ShadowDepth="8"
                                 Direction="270" />
    </Setter>
  </Style>
</Styles>
