<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="using:FluentAvalonia.UI.Controls">
  <SolidColorBrush x:Key="ZzzMixedNavigationSurfaceBrush" Color="#F5222730" />
  <SolidColorBrush x:Key="ZzzMixedContentSurfaceBrush" Color="#FFF7F8FA" />
  <SolidColorBrush x:Key="ZzzMixedContentBorderBrush" Color="#FFCDD2DA" />
  <Thickness x:Key="ZzzMixedContentPadding">12</Thickness>
  <Thickness x:Key="ZzzMixedControlSpacing">0,3</Thickness>
</ResourceDictionary>
