<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="ZzzOd.Gui.Pages.Devtools.ZzzImageAnalysisPage"
             x:CompileBindings="False">
  <Grid Margin="{DynamicResource SampleAppPageMargin}" ColumnDefinitions="440,12,*">
    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <fa:FACommandBar>
          <fa:FACommandBar.PrimaryCommands>
            <fa:FACommandBarButton Label="打开图片" Click="OnOpenImage"><fa:FACommandBarButton.IconSource><fa:FASymbolIconSource Symbol="OpenFile" /></fa:FACommandBarButton.IconSource></fa:FACommandBarButton>
            <fa:FACommandBarButton Label="截图" Click="OnScreenshot"><fa:FACommandBarButton.IconSource><fa:FASymbolIconSource Symbol="Camera" /></fa:FACommandBarButton.IconSource></fa:FACommandBarButton>
            <fa:FACommandBarButton x:Name="ToggleViewButton" Label="切换视图" Click="OnToggleView"><fa:FACommandBarButton.IconSource><fa:FASymbolIconSource Symbol="View" /></fa:FACommandBarButton.IconSource></fa:FACommandBarButton>
            <fa:FACommandBarButton Label="执行" Click="OnRun"><fa:FACommandBarButton.IconSource><fa:FASymbolIconSource Symbol="Play" /></fa:FACommandBarButton.IconSource></fa:FACommandBarButton>
            <fa:FACommandBarButton Label="色彩通道" Click="OnColorChannels"><fa:FACommandBarButton.IconSource><fa:FASymbolIconSource Symbol="Pictures" /></fa:FACommandBarButton.IconSource></fa:FACommandBarButton>
          </fa:FACommandBar.PrimaryCommands>
        </fa:FACommandBar>

        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
          <fa:FAComboBox x:Name="PipelineCombo" PlaceholderText="选择或新建流水线" SelectionChanged="OnPipelineSelectionChanged" />
          <Button Grid.Column="1" Content="保存" Click="OnSavePipeline" />
          <Button Grid.Column="2" Content="另存为" Click="OnSaveAsPipeline" />
          <Button Grid.Column="3" Content="重命名" Click="OnRenamePipeline" />
          <Button Grid.Column="4" Content="删除" Click="OnDeletePipeline" />
        </Grid>

        <ListBox x:Name="StepList" MinHeight="170" SelectionChanged="OnStepSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Name}" Margin="8,5" /></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
          <fa:FAComboBox x:Name="AddStepCombo" PlaceholderText="添加步骤" SelectionChanged="OnAddStep" />
          <Button Grid.Column="1" Content="删除步骤" Click="OnDeleteStep" />
          <Button Grid.Column="2" Content="复制方法" Click="OnCopyCode" />
          <Button Grid.Column="3" Content="上移" Click="OnMoveUp" />
          <Button Grid.Column="4" Content="下移" Click="OnMoveDown" />
        </Grid>

        <TextBlock x:Name="ParameterTitle" Text="参数设置" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="ParameterDescription" TextWrapping="Wrap" />
        <ItemsControl x:Name="ParameterList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3" ColumnDefinitions="*,170">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" ToolTip.Tip="{Binding ToolTip}" />
                <fa:FANumberBox Grid.Column="1" Value="{Binding NumberValue}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SmallChange="{Binding SmallChange}" SpinButtonPlacementMode="Compact" IsVisible="{Binding IsNumber}" ValueChanged="OnParameterNumberChanged" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding BooleanValue}" OnContent="" OffContent="" IsVisible="{Binding IsBoolean}" Click="OnParameterBooleanChanged" />
                <fa:FAComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding ChoiceValue}" IsVisible="{Binding IsChoice}" SelectionChanged="OnParameterChoiceChanged" />
                <Grid Grid.Column="1" ColumnDefinitions="*,*,*" IsVisible="{Binding IsTuple}">
                  <fa:FANumberBox Value="{Binding Tuple0}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SpinButtonPlacementMode="Compact" ValueChanged="OnTuple0Changed" />
                  <fa:FANumberBox Grid.Column="1" Value="{Binding Tuple1}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SpinButtonPlacementMode="Compact" ValueChanged="OnTuple1Changed" />
                  <fa:FANumberBox Grid.Column="2" Value="{Binding Tuple2}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SpinButtonPlacementMode="Compact" ValueChanged="OnTuple2Changed" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox x:Name="ResultText" Height="150" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Image x:Name="PreviewImage" MinWidth="560" MinHeight="420" Stretch="Uniform" />
    </ScrollViewer>

    <fa:FAContentDialog x:Name="PipelineNameDialog" Title="流水线名称" PrimaryButtonText="确定" CloseButtonText="取消">
      <TextBox x:Name="PipelineNameText" Width="360" PlaceholderText="请输入流水线名称" />
    </fa:FAContentDialog>

    <fa:FAContentDialog x:Name="ColorChannelsDialog" Title="色彩通道分析" PrimaryButtonText="确定" DefaultButton="Primary">
      <ScrollViewer Width="900" Height="620" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ColorSpaceList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="6" Margin="0,0,0,18">
                <TextBlock Text="{Binding Name, StringFormat={}{0} 色彩空间}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Channels}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="270" Spacing="4"><TextBlock Text="{Binding Title}" HorizontalAlignment="Center" /><Image Source="{Binding Image}" Height="180" Stretch="Uniform" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </fa:FAContentDialog>
  </Grid>
</UserControl>
