<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:home="using:ZzzOd.Gui.Controls.Home"
             x:Class="ZzzOd.Gui.Pages.Home.ZzzHomePage"
             ClipToBounds="True">
  <UserControl.Resources>
    <fa:ContentDialog x:Key="PreFlightDialog"
                      Title="运行前检查"
                      PrimaryButtonText="前往配置"
                      CloseButtonText="仍然继续"
                      DefaultButton="Primary">
      <StackPanel MinWidth="420"
                  Spacing="8">
        <TextBlock Text="以下配置项未就绪，可能影响正常运行："
                   TextWrapping="Wrap" />
        <ItemsControl x:Name="PreFlightIssueList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </fa:ContentDialog>
  </UserControl.Resources>
  <Grid x:Name="HomeRoot"
        PointerEntered="OnHomePointerEntered"
        PointerExited="OnHomePointerExited">
    <Image x:Name="BannerImage"
           Stretch="UniformToFill" />

    <Border x:Name="MediaPlaceholder"
            Background="#66000000"
            IsHitTestVisible="False" />

    <Grid Margin="32,64,0,32"
          ColumnDefinitions="Auto,*,Auto,70">
      <home:ZzzNoticeCard x:Name="NoticeCard"
                          Grid.Column="0"
                          Width="589"
                          Height="150"
                          VerticalAlignment="Bottom" />

      <Button x:Name="StartButton"
              Grid.Column="2"
              Width="180"
              MinWidth="180"
              Height="48"
              Margin="24,0,5,0"
              VerticalAlignment="Bottom"
              Classes="zzz-home-start"
              Click="OnStartButtonClicked">
        <StackPanel Orientation="Horizontal"
                    Spacing="10">
          <fa:SymbolIcon x:Name="StartButtonIcon"
                         Symbol="PlayFilled"
                         FontSize="20" />
          <TextBlock x:Name="StartButtonText"
                     VerticalAlignment="Center"
                     Text="启动一条龙" />
        </StackPanel>
      </Button>

      <StackPanel Grid.Column="3"
                  Width="70"
                  Height="250"
                  Spacing="8"
                  VerticalAlignment="Center">
        <Button x:Name="HomeLinkButton"
                Height="54"
                Tag="home"
                AutomationProperties.Name="官网"
                Classes="zzz-home-icon-button"
                Click="OnQuickLinkClicked"
                PointerEntered="OnQuickLinkPointerEntered"
                PointerExited="OnQuickLinkPointerExited">
          <fa:SymbolIcon Symbol="Home"
                         FontSize="30" />
        </Button>
        <Button x:Name="GithubLinkButton"
                Height="54"
                Tag="github"
                AutomationProperties.Name="GitHub"
                Classes="zzz-home-icon-button"
                Click="OnQuickLinkClicked"
                PointerEntered="OnQuickLinkPointerEntered"
                PointerExited="OnQuickLinkPointerExited">
          <fa:FAPathIcon Width="30"
                         Height="30"
                         Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.729.084-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                         Stretch="Uniform" />
        </Button>
        <Button x:Name="DocsLinkButton"
                Height="54"
                Tag="docs"
                AutomationProperties.Name="帮助文档"
                Classes="zzz-home-icon-button"
                Click="OnQuickLinkClicked"
                PointerEntered="OnQuickLinkPointerEntered"
                PointerExited="OnQuickLinkPointerExited">
          <fa:SymbolIcon Symbol="Library"
                         FontSize="30" />
        </Button>
        <Button x:Name="ChannelLinkButton"
                Height="54"
                Tag="official-channel"
                AutomationProperties.Name="官方频道"
                Classes="zzz-home-icon-button"
                Click="OnQuickLinkClicked"
                PointerEntered="OnQuickLinkPointerEntered"
                PointerExited="OnQuickLinkPointerExited">
          <fa:SymbolIcon Symbol="Message"
                         FontSize="30" />
        </Button>
      </StackPanel>
    </Grid>

    <TextBlock x:Name="MediaPageCountText"
               Margin="0,0,18,18"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Foreground="White"
               IsVisible="False" />

    <fa:TeachingTip x:Name="QuickLinkTeachingTip"
                    IsLightDismissEnabled="True"
                    PreferredPlacement="Left"
                    TailVisibility="Visible" />

  </Grid>
</UserControl>
