<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:ZzzOd.Gui.Pages.Accounts"
             x:Class="ZzzOd.Gui.Pages.Accounts.ZzzAccountsPage">
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="11"
                Spacing="8">
      <fa:InfoBar x:Name="ActionBar"
                  IsOpen="False"
                  IsClosable="True" />

      <fa:SettingsExpanderItem Content="使用说明"
                               Description="点击启用后到各模块进行设置，各账户之间的设置是独立的。">
        <fa:SettingsExpanderItem.IconSource>
          <fa:SymbolIconSource Symbol="Help" />
        </fa:SettingsExpanderItem.IconSource>
        <fa:SettingsExpanderItem.Footer>
          <Button Content="查看"
                  Click="OnHelpClicked" />
        </fa:SettingsExpanderItem.Footer>
      </fa:SettingsExpanderItem>

      <fa:SettingsExpander Header="当前账户设置"
                           IsExpanded="True">
        <fa:SettingsExpander.IconSource>
          <fa:SymbolIconSource Symbol="Contact" />
        </fa:SettingsExpander.IconSource>

        <fa:SettingsExpanderItem x:Name="GamePathItem"
                                 Content="游戏路径">
          <fa:SettingsExpanderItem.IconSource>
            <fa:SymbolIconSource Symbol="Folder" />
          </fa:SettingsExpanderItem.IconSource>
          <fa:SettingsExpanderItem.Footer>
            <Button Content="选择"
                    Click="OnChooseGamePathClicked" />
          </fa:SettingsExpanderItem.Footer>
        </fa:SettingsExpanderItem>

        <fa:SettingsExpanderItem Content="自定义窗口标题">
          <fa:SettingsExpanderItem.IconSource>
            <fa:SymbolIconSource Symbol="FullScreen" />
          </fa:SettingsExpanderItem.IconSource>
          <fa:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <TextBox x:Name="CustomWindowTitleInput"
                       Width="214"
                       LostFocus="OnCustomWindowTitleLostFocus" />
              <ToggleSwitch x:Name="UseCustomWindowTitleToggle"
                            OnContent=""
                            OffContent=""
                            Click="OnUseCustomWindowTitleChanged" />
            </StackPanel>
          </fa:SettingsExpanderItem.Footer>
        </fa:SettingsExpanderItem>

        <fa:SettingsExpanderItem Content="游戏区服">
          <fa:SettingsExpanderItem.IconSource>
            <fa:SymbolIconSource Symbol="Home" />
          </fa:SettingsExpanderItem.IconSource>
          <fa:SettingsExpanderItem.Footer>
            <fa:FAComboBox x:Name="GameRegionCombo"
                           Width="180"
                           SelectionChanged="OnGameRegionChanged">
              <fa:FAComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:ZzzAccountOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </fa:FAComboBox.ItemTemplate>
            </fa:FAComboBox>
          </fa:SettingsExpanderItem.Footer>
        </fa:SettingsExpanderItem>

        <fa:SettingsExpanderItem x:Name="AccountItem"
                                 Content="账号"
                                 Description="所有信息都明文保存在本地">
          <fa:SettingsExpanderItem.IconSource>
            <fa:SymbolIconSource Symbol="People" />
          </fa:SettingsExpanderItem.IconSource>
          <fa:SettingsExpanderItem.Footer>
            <TextBox x:Name="AccountInput"
                     Width="260"
                     LostFocus="OnAccountLostFocus" />
          </fa:SettingsExpanderItem.Footer>
        </fa:SettingsExpanderItem>

        <fa:SettingsExpanderItem x:Name="PasswordItem"
                                 Content="密码"
                                 Description="请自行妥善管理">
          <fa:SettingsExpanderItem.IconSource>
            <fa:SymbolIconSource Symbol="Permissions" />
          </fa:SettingsExpanderItem.IconSource>
          <fa:SettingsExpanderItem.Footer>
            <TextBox x:Name="PasswordInput"
                     Width="260"
                     PasswordChar="●"
                     LostFocus="OnPasswordLostFocus" />
          </fa:SettingsExpanderItem.Footer>
        </fa:SettingsExpanderItem>

        <fa:SettingsExpanderItem x:Name="BilibiliHelpItem"
                                 Content="B服使用提示"
                                 Description="B服请在『设置 - 脚本环境 - 基础』中设置截图方法为BitBit，否则可能无法识别登录框。"
                                 IsVisible="False">
          <fa:SettingsExpanderItem.IconSource>
            <fa:SymbolIconSource Symbol="Important" />
          </fa:SettingsExpanderItem.IconSource>
        </fa:SettingsExpanderItem>

        <fa:SettingsExpanderItem x:Name="BilibiliAccountItem"
                                 Content="B服用户名"
                                 Description="B服为选择已有登录记录的用户进行登录，需要先手动登录游戏"
                                 IsVisible="False">
          <fa:SettingsExpanderItem.IconSource>
            <fa:SymbolIconSource Symbol="People" />
          </fa:SettingsExpanderItem.IconSource>
          <fa:SettingsExpanderItem.Footer>
            <TextBox x:Name="BilibiliAccountInput"
                     Width="300"
                     Watermark="填写游戏中切换B服账号时显示的用户名"
                     LostFocus="OnBilibiliAccountLostFocus" />
          </fa:SettingsExpanderItem.Footer>
        </fa:SettingsExpanderItem>
      </fa:SettingsExpander>

      <TextBlock Text="账户列表"
                 Margin="0,8,0,0"
                 FontSize="18"
                 FontWeight="SemiBold" />
      <ItemsControl x:Name="InstanceList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ZzzAccountInstanceRow">
            <fa:SettingsExpanderItem Content="{Binding DisplayIndex}"
                                     Margin="0,0,0,6">
              <fa:SettingsExpanderItem.IconSource>
                <fa:SymbolIconSource Symbol="People" />
              </fa:SettingsExpanderItem.IconSource>
              <fa:SettingsExpanderItem.Footer>
                <Grid ColumnDefinitions="120,8,180,8,Auto">
                  <TextBox Grid.Column="0"
                           Text="{Binding Name, Mode=TwoWay}"
                           IsEnabled="{Binding CanEdit}"
                           TextChanged="OnInstanceNameChanged" />
                  <fa:FAComboBox Grid.Column="2"
                                 ItemsSource="{Binding RunOptions}"
                                 SelectedItem="{Binding SelectedRunOption, Mode=TwoWay}"
                                 IsEnabled="{Binding CanEdit}"
                                 SelectionChanged="OnInstanceRunChanged">
                    <fa:FAComboBox.ItemTemplate>
                      <DataTemplate x:DataType="local:ZzzAccountRunOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </fa:FAComboBox.ItemTemplate>
                  </fa:FAComboBox>
                  <fa:CommandBar Grid.Column="4"
                                 DefaultLabelPosition="Right">
                    <fa:CommandBar.PrimaryCommands>
                      <fa:CommandBarButton Label="启用"
                                           IsEnabled="{Binding CanActivate}"
                                           Click="OnActivateInstanceClicked" />
                      <fa:CommandBarButton Label="登录"
                                           IsEnabled="{Binding CanEdit}"
                                           Click="OnLoginInstanceClicked" />
                      <fa:CommandBarButton Label="删除"
                                           IsEnabled="{Binding CanDelete}"
                                           Click="OnDeleteInstanceClicked">
                        <fa:CommandBarButton.IconSource>
                          <fa:SymbolIconSource Symbol="Delete" />
                        </fa:CommandBarButton.IconSource>
                      </fa:CommandBarButton>
                    </fa:CommandBar.PrimaryCommands>
                  </fa:CommandBar>
                </Grid>
              </fa:SettingsExpanderItem.Footer>
            </fa:SettingsExpanderItem>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button x:Name="AddInstanceButton"
              Content="新增"
              Height="40"
              HorizontalAlignment="Stretch"
              Click="OnAddInstanceClicked" />
    </StackPanel>
    </ScrollViewer>

    <fa:ContentDialog x:Name="ProtectionDialog"
                      Title="密码验证"
                      PrimaryButtonText="确定"
                      CloseButtonText="取消"
                      DefaultButton="Primary">
      <TextBox x:Name="ProtectionPasswordInput"
               Width="280"
               Watermark="请输入密码"
               PasswordChar="●" />
    </fa:ContentDialog>
  </Grid>
</UserControl>
