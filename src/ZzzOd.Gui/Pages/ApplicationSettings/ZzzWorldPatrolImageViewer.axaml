<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="ZzzOd.Gui.Pages.ApplicationSettings.ZzzWorldPatrolImageViewer">
  <Grid RowDefinitions="Auto,*" RowSpacing="8">
    <fa:CommandBar Grid.Row="0">
      <fa:CommandBar.Content>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="模式:" VerticalAlignment="Center" />
          <fa:FAComboBox x:Name="ModeCombo" Width="110" SelectionChanged="OnModeChanged" />
          <TextBlock Text="缩放比例:" VerticalAlignment="Center" />
          <fa:NumberBox x:Name="ScaleBox"
                        Width="110"
                        Minimum="10"
                        Maximum="1000"
                        SmallChange="10"
                        Value="100"
                        ValueChanged="OnScaleChanged" />
          <TextBlock x:Name="SelectionText"
                     IsVisible="False"
                     Text="选择区域: 未选择"
                     VerticalAlignment="Center" />
        </StackPanel>
      </fa:CommandBar.Content>
      <fa:CommandBar.PrimaryCommands>
        <fa:CommandBarButton Label="缩小" Click="OnZoomOutClicked" />
        <fa:CommandBarButton Label="放大" Click="OnZoomInClicked" />
        <fa:CommandBarButton Label="适应窗口" Click="OnFitClicked" />
        <fa:CommandBarButton Label="原图" Click="OnOriginalClicked" />
        <fa:CommandBarButton x:Name="ClearSelectionButton"
                             Label="清除选择"
                             IsVisible="False"
                             Click="OnClearSelectionClicked" />
      </fa:CommandBar.PrimaryCommands>
    </fa:CommandBar>

    <ScrollViewer x:Name="ImageScrollViewer"
                  Grid.Row="1"
                  MinWidth="200"
                  MinHeight="200"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <Canvas x:Name="ImageCanvas"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Image x:Name="DisplayImage"
               Canvas.Left="0"
               Canvas.Top="0"
               Stretch="Fill"
               PointerPressed="OnImagePointerPressed"
               PointerMoved="OnImagePointerMoved"
               PointerReleased="OnImagePointerReleased" />
        <Rectangle x:Name="SelectionRectangle"
                   IsVisible="False"
                   IsHitTestVisible="False"
                   Stroke="#B4FF0000"
                   StrokeThickness="2"
                   StrokeDashArray="4,2" />
      </Canvas>
    </ScrollViewer>
  </Grid>
</UserControl>
