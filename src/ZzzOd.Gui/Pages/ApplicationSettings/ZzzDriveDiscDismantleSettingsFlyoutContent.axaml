<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="ZzzOd.Gui.Pages.ApplicationSettings.ZzzDriveDiscDismantleSettingsFlyoutContent"
             MinWidth="420">
  <StackPanel Margin="8" Spacing="1">
    <fa:FAInfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" />
    <fa:FASettingsExpanderItem Content="拆解等级">
      <fa:FASettingsExpanderItem.Footer>
        <fa:FAComboBox x:Name="LevelCombo"
                       Width="180"
                       SelectionChanged="OnLevelChanged" />
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>
    <fa:FASettingsExpanderItem Content="全部已弃置">
      <fa:FASettingsExpanderItem.Footer>
        <ToggleSwitch x:Name="AbandonToggle"
                      Click="OnAbandonChanged" />
      </fa:FASettingsExpanderItem.Footer>
    </fa:FASettingsExpanderItem>
  </StackPanel>
</UserControl>
