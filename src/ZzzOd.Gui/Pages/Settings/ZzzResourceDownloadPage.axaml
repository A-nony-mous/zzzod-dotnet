<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:ZzzOd.Gui.Pages.Settings"
             x:Class="ZzzOd.Gui.Pages.Settings.ZzzResourceDownloadSettingsAxamlPage">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{DynamicResource SampleAppPageMargin}"
                Spacing="{DynamicResource SampleAppSectionSpacing}">
      <fa:FAInfoBar x:Name="ConfigErrorBar"
                  IsOpen="False"
                  IsClosable="True"
                  Severity="Error" />

      <TextBlock Text="资源下载"
                 FontSize="18"
                 FontWeight="SemiBold" />

      <fa:FASettingsExpanderItem Content="下载说明"
                               Description="下载失败时 请尝试到「脚本环境」更改网络代理">
        <fa:FASettingsExpanderItem.IconSource>
          <fa:FASymbolIconSource Symbol="Help" />
        </fa:FASettingsExpanderItem.IconSource>
      </fa:FASettingsExpanderItem>

      <fa:FASettingsExpanderItem x:Name="OcrItem" Content="OCR识别">
        <fa:FASettingsExpanderItem.IconSource>
          <fa:FASymbolIconSource Symbol="Globe" />
        </fa:FASettingsExpanderItem.IconSource>
        <fa:FASettingsExpanderItem.Footer>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <fa:FAComboBox x:Name="OcrProfileCombo"
                           Width="230"
                           SelectionChanged="OnModelSelectionChanged">
              <fa:FAComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:ZzzResourceModelOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </fa:FAComboBox.ItemTemplate>
            </fa:FAComboBox>
            <Button x:Name="OcrDownloadButton" Tag="ocr" Content="下载" Click="OnDownloadClicked" />
            <Button x:Name="OcrCancelButton" Tag="ocr" Content="取消" IsVisible="False" Click="OnCancelClicked" />
            <ToggleSwitch x:Name="OcrGpuToggle"
                          Tag="ocr_use_gpu"
                          OnContent="GPU"
                          OffContent="CPU"
                          Click="OnGpuChanged" />
          </StackPanel>
        </fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>

      <fa:FASettingsExpanderItem x:Name="FlashClassifierItem" Content="闪光识别">
        <fa:FASettingsExpanderItem.IconSource>
          <fa:FASymbolIconSource Symbol="Globe" />
        </fa:FASettingsExpanderItem.IconSource>
        <fa:FASettingsExpanderItem.Footer>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <fa:FAComboBox x:Name="FlashClassifierCombo"
                           Width="270"
                           SelectionChanged="OnModelSelectionChanged">
              <fa:FAComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:ZzzResourceModelOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </fa:FAComboBox.ItemTemplate>
            </fa:FAComboBox>
            <Button x:Name="FlashClassifierDownloadButton" Tag="flash_classifier" Content="下载" Click="OnDownloadClicked" />
            <Button x:Name="FlashClassifierCancelButton" Tag="flash_classifier" Content="取消" IsVisible="False" Click="OnCancelClicked" />
            <ToggleSwitch x:Name="FlashClassifierGpuToggle"
                          Tag="flash_classifier_gpu"
                          OnContent="GPU"
                          OffContent="CPU"
                          Click="OnGpuChanged" />
          </StackPanel>
        </fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>

      <fa:FASettingsExpanderItem x:Name="HollowZeroEventItem" Content="空洞格子识别">
        <fa:FASettingsExpanderItem.IconSource>
          <fa:FASymbolIconSource Symbol="Globe" />
        </fa:FASettingsExpanderItem.IconSource>
        <fa:FASettingsExpanderItem.Footer>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <fa:FAComboBox x:Name="HollowZeroEventCombo"
                           Width="270"
                           SelectionChanged="OnModelSelectionChanged">
              <fa:FAComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:ZzzResourceModelOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </fa:FAComboBox.ItemTemplate>
            </fa:FAComboBox>
            <Button x:Name="HollowZeroEventDownloadButton" Tag="hollow_zero_event" Content="下载" Click="OnDownloadClicked" />
            <Button x:Name="HollowZeroEventCancelButton" Tag="hollow_zero_event" Content="取消" IsVisible="False" Click="OnCancelClicked" />
            <ToggleSwitch x:Name="HollowZeroEventGpuToggle"
                          Tag="hollow_zero_event_gpu"
                          OnContent="GPU"
                          OffContent="CPU"
                          Click="OnGpuChanged" />
          </StackPanel>
        </fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>

      <fa:FASettingsExpanderItem x:Name="LostVoidDetectorItem" Content="迷失之地识别">
        <fa:FASettingsExpanderItem.IconSource>
          <fa:FASymbolIconSource Symbol="Globe" />
        </fa:FASettingsExpanderItem.IconSource>
        <fa:FASettingsExpanderItem.Footer>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <fa:FAComboBox x:Name="LostVoidDetectorCombo"
                           Width="270"
                           SelectionChanged="OnModelSelectionChanged">
              <fa:FAComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:ZzzResourceModelOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </fa:FAComboBox.ItemTemplate>
            </fa:FAComboBox>
            <Button x:Name="LostVoidDetectorDownloadButton" Tag="lost_void_det" Content="下载" Click="OnDownloadClicked" />
            <Button x:Name="LostVoidDetectorCancelButton" Tag="lost_void_det" Content="取消" IsVisible="False" Click="OnCancelClicked" />
            <ToggleSwitch x:Name="LostVoidDetectorGpuToggle"
                          Tag="lost_void_det_gpu"
                          OnContent="GPU"
                          OffContent="CPU"
                          Click="OnGpuChanged" />
          </StackPanel>
        </fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>

      <TextBlock Text="日志显示"
                 Margin="0,8,0,0"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <ContentControl x:Name="LogHost"
                      MinHeight="220" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
