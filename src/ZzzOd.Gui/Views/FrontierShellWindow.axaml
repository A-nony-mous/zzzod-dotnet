<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:ZzzOd.Gui.Shell"
        x:Class="ZzzOd.Gui.Views.FrontierShellWindow"
        x:DataType="shell:ZzzShellViewModel"
        Title="{Binding FrontierWindowTitle}"
        Width="1140"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        ShowActivated="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ZzzOd.Gui/Theme/FrontierShellResources.axaml" />
        <ResourceInclude Source="avares://ZzzOd.Gui/Theme/FrontierNavigationResources.axaml" />
        <ResourceInclude Source="avares://ZzzOd.Gui/Theme/FrontierPageResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <ContentControl x:Name="MainViewHost"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch" />
</Window>
