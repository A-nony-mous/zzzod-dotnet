<local:FrontierShellWindow xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:fa="using:FluentAvalonia.UI.Controls"
                           xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
                           xmlns:local="using:ZzzOd.Gui.Views"
                           xmlns:shell="using:ZzzOd.Gui.Shell"
                           x:Class="ZzzOd.Gui.Views.FrontierShellWindow"
                           x:DataType="shell:ZzzShellViewModel"
                           Title="{Binding WindowTitle}"
                           Width="1140"
                           Height="760"
                           MinWidth="960"
                           MinHeight="640"
                           ShowActivated="True"
                           SystemDecorations="None"
                           ExtendClientAreaToDecorationsHint="True"
                           ExtendClientAreaTitleBarHeightHint="32">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ZzzOd.Gui/Theme/FrontierShellResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="fa|NavigationViewItem">
      <Setter Property="Foreground" Value="#FFF5F7FA" />
    </Style>
    <Style Selector="fa|NavigationViewItem TextBlock">
      <Setter Property="Foreground" Value="#FFF5F7FA" />
    </Style>
    <Style Selector="fa|NavigationViewItem fa|FontIcon">
      <Setter Property="Foreground" Value="#FFF5F7FA" />
    </Style>
    <Style Selector="fa|InfoBar TextBlock">
      <Setter Property="Foreground" Value="#FF1A1C1F" />
    </Style>
  </Window.Styles>
  <Grid Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
    <Image x:Name="BackgroundImage"
           Stretch="UniformToFill"
           IsVisible="False" />
    <ContentControl x:Name="BackgroundVideoHost" IsVisible="False" />
    <fa:NavigationView x:Name="FrontierNavigation"
                       PaneDisplayMode="LeftCompact"
                       Background="#B0111722"
                       OpenPaneLength="240"
                       CompactPaneLength="48"
                       IsPaneOpen="False"
                       Foreground="#FFF5F7FA"
                       IsBackButtonVisible="True"
                       IsBackEnabled="False"
                       IsSettingsVisible="False"
                       BackRequested="OnNavigationBackRequested"
                       SelectionChanged="OnNavigationSelectionChanged">
      <fa:NavigationView.MenuItemTemplate>
        <DataTemplate x:DataType="shell:ZzzNavigationEntry">
          <fa:NavigationViewItem Tag="{Binding Key}"
                                 Content="{Binding Text}"
                                 ToolTip.Tip="{Binding AccessibleName}"
                                 AutomationProperties.Name="{Binding AccessibleName}">
            <fa:NavigationViewItem.IconSource>
              <fa:FontIconSource Glyph="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
            </fa:NavigationViewItem.IconSource>
          </fa:NavigationViewItem>
        </DataTemplate>
      </fa:NavigationView.MenuItemTemplate>
      <fa:NavigationView.Content>
        <Border x:Name="FrontierContentSurface"
                Margin="16,44,16,16"
                Padding="{DynamicResource ZzzFrontierContentPadding}"
                Background="{DynamicResource ZzzFrontierContentSurfaceBrush}"
                TextElement.Foreground="#FFF5F7FA"
                BorderBrush="{DynamicResource ZzzFrontierContentBorderBrush}"
                BorderThickness="1"
                Opacity="0.92"
                CornerRadius="12">
          <fa:Frame x:Name="FrontierContentFrame"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsNavigationStackEnabled="False" />
        </Border>
      </fa:NavigationView.Content>
    </fa:NavigationView>
    <Grid x:Name="FrontierTitleBar"
          Height="32"
          Margin="48,0,0,0"
          ColumnDefinitions="Auto,*,Auto"
          ZIndex="10"
          PointerPressed="OnTitleBarPointerPressed">
      <Image x:Name="FrontierTitleBarIcon" Width="18" Height="18" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="{Binding WindowTitle}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Click="OnMinimizeClicked"><fa:FontIcon Glyph="&#xE921;" /></Button>
        <Button Click="OnMaximizeClicked"><fa:FontIcon Glyph="&#xE922;" /></Button>
        <Button Click="OnCloseClicked"><fa:FontIcon Glyph="&#xE8BB;" /></Button>
      </StackPanel>
    </Grid>
    <fa:InfoBar x:Name="FrontierToastBar"
                Margin="0,40,24,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsOpen="False"
                IsClosable="False"
                ZIndex="20" />
  </Grid>
</local:FrontierShellWindow>
