<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:ZzzOd.Gui.Pages.Settings"
             x:Class="ZzzOd.Gui.Views.FrontierPages.Settings.FrontierGameSettingsPage"
             x:DataType="local:ZzzGameSettingsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ActionKeyTemplate" x:DataType="local:ZzzGameActionKeyRow">
      <fa:FASettingsExpanderItem Content="{Binding Label}">
        <fa:FASettingsExpanderItem.Footer>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fa:FAComboBox Width="150"
                           ItemsSource="{Binding ModifierOptions}"
                           SelectedItem="{Binding SelectedModifier, Mode=TwoWay}">
            <fa:FAComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:ZzzGameSettingOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </fa:FAComboBox.ItemTemplate>
            </fa:FAComboBox>
            <fa:FAComboBox Width="150"
                           ItemsSource="{Binding ButtonOptions}"
                           SelectedItem="{Binding SelectedButton, Mode=TwoWay}">
              <fa:FAComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:ZzzGameSettingOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </fa:FAComboBox.ItemTemplate>
            </fa:FAComboBox>
          </StackPanel>
        </fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>
    </DataTemplate>

    <DataTemplate x:Key="KeyboardKeyTemplate" x:DataType="local:ZzzGameKeyCaptureRow">
      <fa:FASettingsExpanderItem Content="{Binding Label}">
        <fa:FASettingsExpanderItem.Footer>
          <Button MinWidth="150"
                  Content="{Binding DisplayValue}"
                  KeyDown="OnKeyCaptureKeyDown"
                  PointerPressed="OnKeyCapturePointerPressed" />
        </fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>
    </DataTemplate>

    <DataTemplate x:Key="GamepadKeyTemplate" x:DataType="local:ZzzGamepadKeyRow">
      <fa:FASettingsExpanderItem Content="{Binding Label}">
        <fa:FASettingsExpanderItem.Footer>
          <fa:FAComboBox Width="180"
                         ItemsSource="{Binding Options}"
                         SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
            <fa:FAComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:ZzzGameSettingOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </fa:FAComboBox.ItemTemplate>
          </fa:FAComboBox>
        </fa:FASettingsExpanderItem.Footer>
      </fa:FASettingsExpanderItem>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{DynamicResource SampleAppPageMargin}"
                Spacing="{DynamicResource SampleAppSectionSpacing}">
      <fa:FAInfoBar x:Name="DependencyWarningBar"
                  IsOpen="False"
                  IsClosable="False"
                  Severity="Error" />

      <fa:FASettingsExpander Header="设置说明"
                               Description="游戏路径、输入方式等基础设置，建议首次使用前检查一遍">
        <fa:FASettingsExpander.IconSource>
          <fa:FASymbolIconSource Symbol="Help" />
        </fa:FASettingsExpander.IconSource>
        <fa:FASettingsExpander.Footer>
          <Button Content="查看" Click="OnHelpClicked" />
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>

      <TextBlock Text="游戏基础"
                 Margin="0,8,0,0"
                 FontSize="18"
                 FontWeight="SemiBold" />

      <fa:FASettingsExpander x:Name="InputWayItem" Header="输入方式">
        <fa:FASettingsExpander.Footer>
          <fa:FAComboBox x:Name="InputWayCombo"
                         Width="180"
                         ItemsSource="{Binding InputWayOptions}"
                         SelectedItem="{Binding SelectedInputWay, Mode=TwoWay}" />
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>

      <fa:FASettingsExpander x:Name="BackgroundModeExpander"
                           Header="后台模式（测试版）"
                           Description="需要虚拟手柄驱动和 PrintWindow 截图方式。运行时会短暂抢占鼠标进行点击操作，无需游戏窗口置顶。请勿在前台玩支持手柄的游戏。"
                           ItemsSource="{Binding BackgroundActionRows}"
                           ItemTemplate="{StaticResource ActionKeyTemplate}">
        <fa:FASettingsExpander.Footer>
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ToggleSwitch x:Name="BackgroundModeToggle"
                            OnContent=""
                            OffContent=""
                            IsChecked="{Binding BackgroundMode, Mode=TwoWay}" />
              <fa:FAComboBox x:Name="BackgroundGamepadTypeCombo"
                             Width="120"
                             ItemsSource="{Binding BackgroundGamepadTypeOptions}"
                             SelectedItem="{Binding SelectedBackgroundGamepadType, Mode=TwoWay}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="闪切时长（秒）" />
                <TextBlock Text="后台模式切换键鼠输入时的前台停留时长，过小可能切换失败"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <fa:FANumberBox x:Name="MouseFlashDurationBox"
                              Grid.Column="1"
                              Width="150"
                              Minimum="0.01"
                              Maximum="0.2"
                              SmallChange="0.01"
                              SpinButtonPlacementMode="Compact"
                              Value="{Binding MouseFlashDuration, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>

      <fa:FASettingsExpander Header="切换 HDR 状态"
                               Description="仅影响手动启动游戏，一条龙启动游戏会自动禁用 HDR">
        <fa:FASettingsExpander.Footer>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="DisableHdrButton"
                    Content="禁用 HDR"
                    Click="OnDisableHdrClicked" />
            <Button x:Name="EnableHdrButton"
                    Content="启用 HDR"
                    Click="OnEnableHdrClicked" />
          </StackPanel>
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>

      <fa:FASettingsExpander Header="启动参数">
        <fa:FASettingsExpander.Footer>
          <ToggleSwitch x:Name="LaunchArgumentToggle"
                        OnContent=""
                        OffContent=""
                        IsChecked="{Binding LaunchArgument, Mode=TwoWay}" />
        </fa:FASettingsExpander.Footer>
        <fa:FASettingsExpanderItem Content="窗口尺寸">
          <fa:FASettingsExpanderItem.Footer>
          <fa:FAComboBox x:Name="ScreenSizeCombo"
                         Width="180"
                         ItemsSource="{Binding ScreenSizeOptions}"
                         SelectedItem="{Binding SelectedScreenSize, Mode=TwoWay}" />
          </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Content="全屏">
          <fa:FASettingsExpanderItem.Footer>
          <fa:FAComboBox x:Name="FullScreenCombo"
                         Width="180"
                         ItemsSource="{Binding FullScreenOptions}"
                         SelectedItem="{Binding SelectedFullScreen, Mode=TwoWay}" />
          </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Content="无边框窗口">
          <fa:FASettingsExpanderItem.Footer>
            <ToggleSwitch x:Name="PopupWindowToggle"
                          OnContent=""
                          OffContent=""
                          IsChecked="{Binding PopupWindow, Mode=TwoWay}" />
          </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Content="显示器序号">
          <fa:FASettingsExpanderItem.Footer>
          <fa:FAComboBox x:Name="MonitorCombo"
                         Width="180"
                         ItemsSource="{Binding MonitorOptions}"
                         SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}" />
          </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Content="高级参数">
          <fa:FASettingsExpanderItem.Footer>
            <TextBox x:Name="LaunchArgumentAdvanceTextBox"
                     Width="300"
                     PlaceholderText="如果你不知道这是做什么的 请不要填写"
                     Text="{Binding LaunchArgumentAdvance, Mode=TwoWay}" />
          </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>
      </fa:FASettingsExpander>

      <TextBlock Text="按键设置"
                 Margin="0,8,0,0"
                 FontSize="18"
                 FontWeight="SemiBold" />

      <fa:FASettingsExpander Header="操控方式"
                               Description="仅影响自动战斗。如需使用手柄，请先安装虚拟手柄依赖。">
        <fa:FASettingsExpander.Footer>
          <fa:FAComboBox x:Name="ControlMethodCombo"
                         Width="180"
                         ItemsSource="{Binding ControlMethodOptions}"
                         SelectedItem="{Binding SelectedControlMethod, Mode=TwoWay}" />
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>

      <fa:FASettingsExpander Header="键盘按键"
                             ItemsSource="{Binding KeyboardRows}"
                             ItemTemplate="{StaticResource KeyboardKeyTemplate}" />

      <fa:FASettingsExpander Header="手柄按键"
                             ItemsSource="{Binding GamepadRows}"
                             ItemTemplate="{StaticResource GamepadKeyTemplate}">
        <fa:FASettingsExpander.Footer>
          <StackPanel Spacing="8">
            <fa:FAComboBox x:Name="GamepadDisplayCombo"
                           Width="120"
                           ItemsSource="{Binding GamepadDisplayOptions}"
                           SelectedItem="{Binding SelectedGamepadDisplay, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="单次按键持续时间(秒)" />
                <TextBlock Text="自行调整，过小可能按键被吞，过大可能影响操作"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <fa:FANumberBox x:Name="GamepadKeyPressTimeBox"
                              Grid.Column="1"
                              Width="150"
                              Minimum="0"
                              Maximum="10"
                              SmallChange="0.01"
                              SpinButtonPlacementMode="Compact"
                              Value="{Binding GamepadKeyPressTime, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
