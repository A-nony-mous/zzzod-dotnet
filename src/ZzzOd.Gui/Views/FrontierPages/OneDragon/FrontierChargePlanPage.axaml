<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:ZzzOd.Gui.PageModels.OneDragon"
             x:Class="ZzzOd.Gui.Views.FrontierPages.OneDragon.FrontierChargePlanPage">
  <UserControl.Resources>
    <DataTemplate x:Key="ChargePlanRowTemplate"
                  x:DataType="local:ZzzChargePlanRowModel">
      <fa:FASettingsExpander Margin="0,0,0,6"
                               DragDrop.AllowDrop="True"
                               PointerPressed="OnPlanPointerPressed"
                               PointerMoved="OnPlanPointerMoved"
                               DragDrop.DragOver="OnPlanDragOver"
                               DragDrop.Drop="OnPlanDrop">
        <fa:FASettingsExpander.IconSource>
          <fa:FAFontIconSource Glyph="&#xE787;" />
        </fa:FASettingsExpander.IconSource>
        <fa:FASettingsExpander.Footer>
          <StackPanel Spacing="6">
            <WrapPanel Orientation="Horizontal">
              <fa:FAComboBox Width="132"
                             Margin="0,0,6,6"
                             ItemsSource="{Binding CategoryOptions}"
                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             SelectionChanged="OnCategoryChanged">
                <fa:FAComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ZzzChargePlanOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </fa:FAComboBox.ItemTemplate>
              </fa:FAComboBox>
              <fa:FAComboBox Width="142"
                             Margin="0,0,6,6"
                             ItemsSource="{Binding MissionTypeOptions}"
                             SelectedItem="{Binding SelectedMissionType, Mode=TwoWay}"
                             SelectionChanged="OnMissionTypeChanged">
                <fa:FAComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ZzzChargePlanOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </fa:FAComboBox.ItemTemplate>
              </fa:FAComboBox>
              <fa:FAComboBox Width="132"
                             Margin="0,0,6,6"
                             IsVisible="{Binding IsMissionVisible}"
                             ItemsSource="{Binding MissionOptions}"
                             SelectedItem="{Binding SelectedMission, Mode=TwoWay}"
                             SelectionChanged="OnMissionChanged">
                <fa:FAComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ZzzChargePlanOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </fa:FAComboBox.ItemTemplate>
              </fa:FAComboBox>
              <fa:FAComboBox Width="110"
                             Margin="0,0,6,6"
                             IsVisible="{Binding IsCardNumVisible}"
                             ItemsSource="{Binding CardNumOptions}"
                             SelectedItem="{Binding SelectedCardNum, Mode=TwoWay}"
                             SelectionChanged="OnCardNumChanged">
                <fa:FAComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ZzzChargePlanOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </fa:FAComboBox.ItemTemplate>
              </fa:FAComboBox>
              <fa:FAComboBox Width="112"
                             Margin="0,0,6,6"
                             IsVisible="{Binding IsBuffVisible}"
                             ItemsSource="{Binding BuffOptions}"
                             SelectedItem="{Binding SelectedBuff, Mode=TwoWay}"
                             SelectionChanged="OnBuffChanged">
                <fa:FAComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ZzzChargePlanOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </fa:FAComboBox.ItemTemplate>
              </fa:FAComboBox>
              <fa:FAComboBox Width="132"
                             Margin="0,0,6,6"
                             ItemsSource="{Binding TeamOptions}"
                             SelectedItem="{Binding SelectedTeam, Mode=TwoWay}"
                             SelectionChanged="OnTeamChanged">
                <fa:FAComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ZzzChargePlanOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </fa:FAComboBox.ItemTemplate>
              </fa:FAComboBox>
              <fa:FAComboBox Width="142"
                             Margin="0,0,6,6"
                             IsVisible="{Binding IsAutoBattleVisible}"
                             ItemsSource="{Binding AutoBattleOptions}"
                             SelectedItem="{Binding SelectedAutoBattle, Mode=TwoWay}"
                             SelectionChanged="OnAutoBattleChanged">
                <fa:FAComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ZzzChargePlanOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </fa:FAComboBox.ItemTemplate>
              </fa:FAComboBox>
            </WrapPanel>
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Right">
              <TextBlock Text="已运行次数"
                         VerticalAlignment="Center" />
              <TextBox Width="64"
                       Text="{Binding RunTimesText, Mode=TwoWay}"
                       TextChanged="OnRunTimesChanged" />
              <TextBlock Text="计划次数"
                         VerticalAlignment="Center" />
              <TextBox Width="64"
                       Text="{Binding PlanTimesText, Mode=TwoWay}"
                       TextChanged="OnPlanTimesChanged" />
              <Button Width="36"
                      Height="32"
                      Padding="0"
                      ToolTip.Tip="置顶"
                      IsVisible="{Binding ShowCommands}"
                      Click="OnMovePlanTopClicked">
                <fa:FAFontIcon Glyph="&#xE74A;" />
              </Button>
              <Button Width="36"
                      Height="32"
                      Padding="0"
                      ToolTip.Tip="删除"
                      IsVisible="{Binding ShowCommands}"
                      Click="OnDeletePlanClicked">
                <fa:FASymbolIcon Symbol="Delete" />
              </Button>
            </StackPanel>
          </StackPanel>
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
    </DataTemplate>
    <fa:FAContentDialog x:Key="AddPlanDialog"
                      Title="新增体力计划"
                      PrimaryButtonText="确定"
                      CloseButtonText="取消"
                      DefaultButton="Primary">
      <ContentControl x:Name="DialogPlanHost"
                      ContentTemplate="{StaticResource ChargePlanRowTemplate}" />
    </fa:FAContentDialog>
    <fa:FAContentDialog x:Key="ConfirmDialog"
                      Title="警告"
                      PrimaryButtonText="确定"
                      CloseButtonText="取消"
                      DefaultButton="Primary">
      <TextBlock x:Name="ConfirmMessage"
                 TextWrapping="Wrap" />
    </fa:FAContentDialog>
  </UserControl.Resources>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0"
                  Padding="{DynamicResource SampleAppPageMargin}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <fa:FAInfoBar x:Name="ErrorBar"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Error" />
        <fa:FASettingsExpander Header="体力计划说明"
                               Description="合理安排每日体力消耗，支持自定义优先级和循环执行">
          <fa:FASettingsExpander.IconSource>
            <fa:FASymbolIconSource Symbol="Message" />
          </fa:FASettingsExpander.IconSource>
          <fa:FASettingsExpander.Footer>
            <Button Content="点此查看指南"
                    Click="OnHelpClicked" />
          </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>

        <Grid ColumnDefinitions="*,6,*">
          <fa:FASettingsExpander Header="循环执行"
                                 Description="开启后，全部计划均达到计划次数后，已运行次数会清零并开始下一轮">
            <fa:FASettingsExpander.Footer>
              <ToggleSwitch x:Name="LoopToggle"
                            OnContent=""
                            OffContent=""
                            Click="OnLoopChanged" />
            </fa:FASettingsExpander.Footer>
          </fa:FASettingsExpander>
          <fa:FASettingsExpander Grid.Column="2"
                                 Header="跳过计划"
                                 Description="开启后，某项计划因电量不足且无法恢复达标时，会依次尝试后续计划">
            <fa:FASettingsExpander.Footer>
              <ToggleSwitch x:Name="SkipPlanToggle"
                            OnContent=""
                            OffContent=""
                            Click="OnSkipPlanChanged" />
            </fa:FASettingsExpander.Footer>
          </fa:FASettingsExpander>
        </Grid>

        <Grid ColumnDefinitions="*,6,*">
          <fa:FASettingsExpander Header="每日重置"
                                 Description="开启后，每天首次运行体力计划前，会将所有体力计划已运行次数清零">
            <fa:FASettingsExpander.Footer>
              <ToggleSwitch x:Name="DailyResetToggle"
                            OnContent=""
                            OffContent=""
                            Click="OnDailyResetChanged" />
            </fa:FASettingsExpander.Footer>
          </fa:FASettingsExpander>
          <fa:FASettingsExpander Grid.Column="2"
                                 Header="恢复电量"
                                 Description="体力不足时按所选方式恢复。若提取后仍不足以触发挑战则会跳过提取">
            <fa:FASettingsExpander.Footer>
              <fa:FAComboBox x:Name="RestoreChargeCombo"
                             Width="210"
                             SelectionChanged="OnRestoreChargeChanged" />
            </fa:FASettingsExpander.Footer>
          </fa:FASettingsExpander>
        </Grid>

        <fa:FASettingsExpander Header="双倍活动"
                             Description="有活动时自动添加对应任务"
                             IsExpanded="True">
          <fa:FASettingsExpander.IconSource>
            <fa:FAFontIconSource Glyph="&#xE7C1;" />
          </fa:FASettingsExpander.IconSource>
          <fa:FASettingsExpander.Footer>
            <ToggleSwitch x:Name="DoubleRewardToggle"
                          OnContent=""
                          OffContent=""
                          Click="OnDoubleRewardChanged" />
          </fa:FASettingsExpander.Footer>
          <fa:FASettingsExpanderItem Content="实战模拟室">
            <fa:FASettingsExpanderItem.Footer>
              <WrapPanel Orientation="Horizontal">
                <fa:FAComboBox x:Name="DoubleCategoryCombo"
                               Width="132"
                               Margin="0,0,6,6"
                               IsEnabled="False" />
                <fa:FAComboBox x:Name="DoubleMissionTypeCombo"
                               Width="142"
                               Margin="0,0,6,6"
                               SelectionChanged="OnDoubleMissionTypeChanged" />
                <fa:FAComboBox x:Name="DoubleMissionCombo"
                               Width="132"
                               Margin="0,0,6,6"
                               SelectionChanged="OnDoubleMissionChanged" />
                <fa:FAComboBox x:Name="DoubleTeamCombo"
                               Width="132"
                               Margin="0,0,6,6"
                               SelectionChanged="OnDoubleTeamChanged" />
                <fa:FAComboBox x:Name="DoubleAutoBattleCombo"
                               Width="142"
                               Margin="0,0,6,6"
                               SelectionChanged="OnDoubleAutoBattleChanged" />
              </WrapPanel>
            </fa:FASettingsExpanderItem.Footer>
          </fa:FASettingsExpanderItem>
        </fa:FASettingsExpander>

        <fa:FASettingsExpander Header="删除体力计划">
          <fa:FASettingsExpander.IconSource>
            <fa:FASymbolIconSource Symbol="Delete" />
          </fa:FASettingsExpander.IconSource>
          <fa:FASettingsExpander.Footer>
            <fa:FACommandBar DefaultLabelPosition="Right">
              <fa:FACommandBar.PrimaryCommands>
                <fa:FACommandBarButton x:Name="UndoButton"
                                     Label="撤销"
                                     IsEnabled="False"
                                     Click="OnUndoClicked" />
                <fa:FACommandBarButton Label="删除已完成"
                                     Click="OnDeleteCompletedClicked" />
                <fa:FACommandBarButton Label="删除所有"
                                     Click="OnDeleteAllClicked" />
              </fa:FACommandBar.PrimaryCommands>
            </fa:FACommandBar>
          </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>

        <fa:FASettingsExpander x:Name="PlanList"
                               Header="体力计划"
                               IsExpanded="True"
                               ItemTemplate="{StaticResource ChargePlanRowTemplate}" />
      </StackPanel>
    </ScrollViewer>
    <Button x:Name="AddPlanButton"
            Grid.Row="1"
            Margin="11,6"
            Content="新增"
            HorizontalAlignment="Left"
            Click="OnAddClicked" />
  </Grid>
</UserControl>
