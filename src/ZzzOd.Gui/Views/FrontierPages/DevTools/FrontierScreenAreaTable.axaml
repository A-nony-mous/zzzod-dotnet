<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="ZzzOd.Gui.Views.FrontierPages.DevTools.FrontierScreenAreaTable"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*"
        RowSpacing="4">
      <Grid Grid.Row="0"
            ColumnDefinitions="48,48,140,80,80,80,80,140,90,120,130,90,140,150,120"
            ColumnSpacing="4">
        <TextBlock Grid.Column="0" Text="操作" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="标识" FontWeight="SemiBold" />
        <TextBlock Grid.Column="2" Text="区域名称" FontWeight="SemiBold" />
        <TextBlock Grid.Column="3" Text="X1" FontWeight="SemiBold" />
        <TextBlock Grid.Column="4" Text="Y1" FontWeight="SemiBold" />
        <TextBlock Grid.Column="5" Text="X2" FontWeight="SemiBold" />
        <TextBlock Grid.Column="6" Text="Y2" FontWeight="SemiBold" />
        <TextBlock Grid.Column="7" Text="OCR文本" FontWeight="SemiBold" />
        <TextBlock Grid.Column="8" Text="OCR阈值" FontWeight="SemiBold" />
        <TextBlock Grid.Column="9" Text="模板目录" FontWeight="SemiBold" />
        <TextBlock Grid.Column="10" Text="模板ID" FontWeight="SemiBold" />
        <TextBlock Grid.Column="11" Text="模板阈值" FontWeight="SemiBold" />
        <TextBlock Grid.Column="12" Text="颜色范围" FontWeight="SemiBold" />
        <TextBlock Grid.Column="13" Text="前往画面" FontWeight="SemiBold" />
        <TextBlock Grid.Column="14" Text="手柄键" FontWeight="SemiBold" />
      </Grid>
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="48,48,140,80,80,80,80,140,90,120,130,90,140,150,120"
                  ColumnSpacing="4">
              <Button Grid.Column="0" Tag="{Binding}" Click="OnSelectClicked" ToolTip.Tip="选中区域">定位</Button>
              <CheckBox Grid.Column="1" IsChecked="{Binding IdMark, Mode=TwoWay}" HorizontalAlignment="Center" />
              <TextBox Grid.Column="2" Text="{Binding AreaName, Mode=TwoWay}" />
              <fa:FANumberBox Grid.Column="3" Value="{Binding X1, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
              <fa:FANumberBox Grid.Column="4" Value="{Binding Y1, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
              <fa:FANumberBox Grid.Column="5" Value="{Binding X2, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
              <fa:FANumberBox Grid.Column="6" Value="{Binding Y2, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
              <TextBox Grid.Column="7" Text="{Binding Text, Mode=TwoWay}" />
              <fa:FANumberBox Grid.Column="8" Value="{Binding LcsPercent, Mode=TwoWay}" Minimum="0" Maximum="1" SmallChange="0.05" />
              <TextBox Grid.Column="9" Text="{Binding TemplateSubDir, Mode=TwoWay}" />
              <TextBox Grid.Column="10" Text="{Binding TemplateId, Mode=TwoWay}" />
              <fa:FANumberBox Grid.Column="11" Value="{Binding TemplateMatchThreshold, Mode=TwoWay}" Minimum="0" Maximum="1" SmallChange="0.05" />
              <TextBox Grid.Column="12" Text="{Binding ColorRangeText, Mode=TwoWay}" />
              <TextBox Grid.Column="13" Text="{Binding GotoListText, Mode=TwoWay}" />
              <TextBox Grid.Column="14" Text="{Binding GamepadKey, Mode=TwoWay}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
