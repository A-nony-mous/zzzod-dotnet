<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:ZzzOd.Gui.Views.FrontierPages.Standalone"
             x:Class="ZzzOd.Gui.Views.FrontierPages.Standalone.FrontierStandaloneAppRunPage">
  <Grid Margin="{DynamicResource SampleAppPageMargin}"
        ColumnDefinitions="*,10,*">
    <Grid Grid.Column="0"
          RowDefinitions="Auto,*,Auto">
      <fa:FAInfoBar x:Name="ActionInfoBar"
                  IsOpen="False"
                  IsClosable="True"
                  Severity="Error" />

      <ScrollViewer Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <fa:FASettingsExpander x:Name="AppList"
                               Header="应用安排"
                               IsExpanded="True">
          <fa:FASettingsExpander.ItemTemplate>
            <DataTemplate x:DataType="local:ZzzStandaloneAppRowModel">
              <fa:FASettingsExpanderItem Content="{Binding Name}"
                                         Margin="0,0,0,1"
                                         Opacity="{Binding Opacity}"
                                         Tag="{Binding}"
                                         DragDrop.AllowDrop="True"
                                         PointerPressed="OnAppPointerPressed"
                                         PointerMoved="OnAppPointerMoved"
                                         DragDrop.DragOver="OnAppDragOver"
                                         DragDrop.Drop="OnAppDrop">
                <fa:FASettingsExpanderItem.IconSource>
                  <fa:FAFontIconSource Glyph="&#xE7FC;" />
                </fa:FASettingsExpanderItem.IconSource>
                <fa:FASettingsExpanderItem.Footer>
                  <StackPanel Orientation="Horizontal"
                              Spacing="4">
                    <Button Width="36"
                            Height="32"
                            Padding="0"
                            ToolTip.Tip="应用设置"
                            IsVisible="{Binding SettingVisible}"
                            Tag="{Binding}"
                            Click="OnAppSettingClicked">
                      <fa:FAFontIcon Glyph="&#xE713;" />
                    </Button>
                    <Button Width="36"
                            Height="32"
                            Padding="0"
                            ToolTip.Tip="移除"
                            Tag="{Binding}"
                            Click="OnRemoveClicked">
                      <fa:FASymbolIcon Symbol="Cancel" />
                    </Button>
                  </StackPanel>
                </fa:FASettingsExpanderItem.Footer>
              </fa:FASettingsExpanderItem>
            </DataTemplate>
          </fa:FASettingsExpander.ItemTemplate>
        </fa:FASettingsExpander>
      </ScrollViewer>

      <Button x:Name="AddAppButton"
              Grid.Row="2"
              Margin="0,8,16,0"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Classes="accent"
              Click="OnAddAppClicked">
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <fa:FASymbolIcon Symbol="Add" />
          <TextBlock Text="添加应用" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Column="2"
          RowDefinitions="Auto,*">
      <fa:FASettingsExpander Header="应用运行说明"
                               Description="从应用列表中选择单个功能模块独立运行，无需跑完整的一条龙流程">
        <fa:FASettingsExpander.IconSource>
          <fa:FASymbolIconSource Symbol="Message" />
        </fa:FASettingsExpander.IconSource>
        <fa:FASettingsExpander.Footer>
          <Button Content="点此查看指南"
                  Click="OnHelpClicked" />
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
      <ContentControl x:Name="RunHost"
                      Grid.Row="1"
                      Margin="0,8,0,11"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
    </Grid>
  </Grid>
</UserControl>
