<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZzzOd.Gui.Views.FrontierPages.GameAssistant.FrontierCommissionAssistantPage">
  <UserControl.Styles>
    <Style Selector="TextBlock#StateText">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="ContentControl#LogHost">
      <Setter Property="Height" Value="300" />
    </Style>
    <Style Selector="ContentControl#LogHost ScrollViewer">
      <Setter Property="MinHeight" Value="300" />
      <Setter Property="MaxHeight" Value="300" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="{DynamicResource SampleAppPageMargin}"
        RowDefinitions="*,12,Auto">
    <ContentControl x:Name="CommissionSettingsHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
    <ContentControl x:Name="CommissionRunHost"
                    Grid.Row="2"
                    HorizontalContentAlignment="Stretch" />
  </Grid>
</UserControl>
