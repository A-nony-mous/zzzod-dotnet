<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="ZzzOd.Gui.Views.FrontierPages.GameAssistant.FrontierGameAssistantPage">

  <TabControl Classes="zzz-pivot" x:Name="AssistantPivot"
              Margin="0,8,0,0"
              Padding="0">
    <TabItem x:Name="BattleTab"
                    Header="战斗助手"
                    MinWidth="88"
                    Classes="zzz-pivot-item"
                    Focusable="True"
                    AutomationProperties.Name="战斗助手 选项卡">
      <fa:FAFrame x:Name="BattleFrame"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsNavigationStackEnabled="False" />
    </TabItem>
    <TabItem x:Name="CommissionTab"
                    Header="委托助手"
                    MinWidth="88"
                    Classes="zzz-pivot-item"
                    Focusable="True"
                    AutomationProperties.Name="委托助手 选项卡">
      <fa:FAFrame x:Name="CommissionFrame"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsNavigationStackEnabled="False" />
    </TabItem>
  </TabControl>
</UserControl>
