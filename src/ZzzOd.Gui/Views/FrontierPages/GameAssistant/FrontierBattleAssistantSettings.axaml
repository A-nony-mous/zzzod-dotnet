<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="ZzzOd.Gui.Views.FrontierPages.GameAssistant.FrontierBattleAssistantSettings">
  <UserControl.Styles>
    <Style Selector="fa|FASettingsExpander">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <!-- 内层 TabViewListView 的滚动区自带一份底部分隔线，/template/ 只能穿一层，需要单独关掉。 -->
    <Style Selector="ScrollViewer /template/ Rectangle#LeftBottomBorderLine">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ScrollViewer /template/ Rectangle#RightBottomBorderLine">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fa|FATabView#ModeTabs /template/ Rectangle#LeftBottomBorderLine">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fa|FATabView#ModeTabs /template/ Rectangle#RightBottomBorderLine">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fa|FATabViewItem.battle-mode-tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="fa|FATabViewItem.battle-mode-tab /template/ Border#BottomBorderLine">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fa|FATabViewItem.battle-mode-tab /template/ Path#LeftRadiusRenderArc">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fa|FATabViewItem.battle-mode-tab /template/ Path#RightRadiusRenderArc">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fa|FATabViewItem.battle-mode-tab /template/ Path#SelectedBackgroundPath">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fa|FATabViewItem.battle-mode-tab /template/ Border#TabSeparator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fa|FATabViewItem.battle-mode-tab /template/ Border#TabContainerBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="fa|FATabViewItem.battle-mode-tab Border.battle-mode-indicator">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="fa|FATabViewItem.battle-mode-tab:selected Border.battle-mode-indicator">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left" Margin="16,0,0,0">
        <fa:FAInfoBar x:Name="SettingsErrorBar"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Error" />
        <fa:FATabView x:Name="ModeTabs"
                    TabWidthMode="Equal"
                    IsAddTabButtonVisible="False"
                    CanDragTabs="False"
                    CanReorderTabs="False">
          <fa:FATabViewItem Header="自动战斗"
                          IsClosable="False"
                          Classes="battle-mode-tab"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Top">
            <fa:FATabViewItem.HeaderTemplate>
              <DataTemplate>
                <Grid Height="36" RowDefinitions="*,3">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Text="{Binding}" />
                  <Border Grid.Row="1"
                          Classes="battle-mode-indicator"
                          Width="16"
                          Height="3"
                          CornerRadius="2"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource SystemAccentColor}" />
                </Grid>
              </DataTemplate>
            </fa:FATabViewItem.HeaderTemplate>
            <StackPanel Spacing="8">
              <fa:FACommandBar x:Name="HelpCommandBar"
                             Height="48"
                             DefaultLabelPosition="Right"
                             IsDynamicOverflowEnabled="False"
                             OverflowButtonVisibility="Collapsed">
                <fa:FACommandBar.Content>
                  <Grid Margin="8,0"
                        ColumnDefinitions="Auto,8,Auto"
                        VerticalAlignment="Center">
                    <fa:FASymbolIcon Symbol="Message"
                                   VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="使用说明"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="先看说明 再使用与提问" />
                    </StackPanel>
                  </Grid>
                </fa:FACommandBar.Content>
                <fa:FACommandBar.PrimaryCommands>
                  <fa:FACommandBarButton Label="如何让AI打得更好？"
                                       Click="OnHelpClicked" />
                  <fa:FACommandBarButton Label="查看指南"
                                       Click="OnGuideClicked" />
                  <fa:FACommandBarButton Label="前往社区"
                                       Click="OnCommunityClicked" />
                </fa:FACommandBar.PrimaryCommands>
              </fa:FACommandBar>
              <fa:FASettingsExpander Header="战斗配置"
                                       Description="全配队通用会自动为您的队伍匹配专属配队，遇到问题请反馈。">
                <fa:FASettingsExpander.IconSource>
                  <fa:FAFontIconSource Glyph="&#xE7FC;" />
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                  <StackPanel Orientation="Horizontal"
                              Spacing="8">
                    <fa:FAComboBox x:Name="AutoBattleConfigCombo"
                                   Width="120" />
                    <fa:FACommandBarButton x:Name="DeleteAutoBattleConfigButton"
                                         Width="40"
                                         Label=""
                                         AutomationProperties.Name="删除战斗配置"
                                         Click="OnDeleteAutoBattleConfigClicked">
                      <fa:FACommandBarButton.IconSource>
                        <fa:FASymbolIconSource Symbol="Delete" />
                      </fa:FACommandBarButton.IconSource>
                    </fa:FACommandBarButton>
                  </StackPanel>
                </fa:FASettingsExpander.Footer>
              </fa:FASettingsExpander>
              <fa:FASettingsExpander Header="终结技一好就放"
                                       Description="终结技无视时机立刻释放">
                <fa:FASettingsExpander.IconSource>
                  <fa:FAFontIconSource Glyph="&#xE7FC;" />
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                  <ToggleSwitch x:Name="AutoUltimateToggle"
                                OnContent="开"
                                OffContent="关" />
                </fa:FASettingsExpander.Footer>
              </fa:FASettingsExpander>
              <fa:FASettingsExpander Header="使用合并配置文件"
                                       Description="关闭用于调试模板文件 正常开启即可">
                <fa:FASettingsExpander.IconSource>
                  <fa:FAFontIconSource Glyph="&#xE7FC;" />
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                  <ToggleSwitch x:Name="MergedFileToggle"
                                OnContent="开"
                                OffContent="关" />
                </fa:FASettingsExpander.Footer>
              </fa:FASettingsExpander>
            </StackPanel>
          </fa:FATabViewItem>
          <fa:FATabViewItem Header="闪避助手"
                          IsClosable="False"
                          Classes="battle-mode-tab"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Top">
            <fa:FATabViewItem.HeaderTemplate>
              <DataTemplate>
                <Grid Height="36" RowDefinitions="*,3">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Text="{Binding}" />
                  <Border Grid.Row="1"
                          Classes="battle-mode-indicator"
                          Width="16"
                          Height="3"
                          CornerRadius="2"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource SystemAccentColor}" />
                </Grid>
              </DataTemplate>
            </fa:FATabViewItem.HeaderTemplate>
            <fa:FASettingsExpander Header="闪避方式"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top">
              <fa:FASettingsExpander.IconSource>
                <fa:FAFontIconSource Glyph="&#xE7FC;" />
              </fa:FASettingsExpander.IconSource>
              <fa:FASettingsExpander.Footer>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <fa:FAComboBox x:Name="DodgeConfigCombo"
                                 Width="120" />
                  <fa:FACommandBarButton x:Name="DeleteDodgeConfigButton"
                                       Width="40"
                                       Label=""
                                       AutomationProperties.Name="删除闪避配置"
                                       Click="OnDeleteDodgeConfigClicked">
                    <fa:FACommandBarButton.IconSource>
                      <fa:FASymbolIconSource Symbol="Delete" />
                    </fa:FACommandBarButton.IconSource>
                  </fa:FACommandBarButton>
                </StackPanel>
              </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
          </fa:FATabViewItem>
        </fa:FATabView>
        <fa:FASettingsExpander Header="GPU运算"
                                 Description="游戏画面掉帧的话 可以不启用">
          <fa:FASettingsExpander.IconSource>
            <fa:FAFontIconSource Glyph="&#xE7FC;" />
          </fa:FASettingsExpander.IconSource>
          <fa:FASettingsExpander.Footer>
            <ToggleSwitch x:Name="GpuToggle"
                          OnContent="开"
                          OffContent="关" />
          </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>
        <fa:FASettingsExpander Header="截图间隔 (秒)"
                                 Description="一般默认0.02，除非电脑很卡。优先通过设置游戏30帧和低画质给AI留算力">
          <fa:FASettingsExpander.IconSource>
            <fa:FAFontIconSource Glyph="&#xE823;" />
          </fa:FASettingsExpander.IconSource>
          <fa:FASettingsExpander.Footer>
            <fa:FANumberBox x:Name="ScreenshotIntervalNumber"
                          Minimum="0.02"
                          Maximum="0.1"
                          SmallChange="0.01"
                          SpinButtonPlacementMode="Inline"
                          Width="140" />
          </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>
        <fa:FASettingsExpander Header="操作方式"
                                 Description="仅影响自动战斗。如需使用手柄，请先安装虚拟手柄依赖。">
          <fa:FASettingsExpander.IconSource>
            <fa:FAFontIconSource Glyph="&#xE7FC;" />
          </fa:FASettingsExpander.IconSource>
          <fa:FASettingsExpander.Footer>
            <fa:FAComboBox x:Name="ControlMethodCombo"
                           Width="72" />
          </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>
      </StackPanel>
    </ScrollViewer>

    <fa:FAContentDialog x:Name="BattleHelpDialog"
                      Title="使用说明"
                      CloseButtonText="确认"
                      DefaultButton="Close">
      <ScrollViewer MaxHeight="620"
                    MaxWidth="760">
        <TextBlock TextWrapping="Wrap"
                   Text="为了让您的自动战斗体验更加顺畅，这里有一些温馨的小建议给到您：&#10;&#10;1. 关于画面设置：建议您将游戏帧数限制在 30 帧，并适当降低画质设置。如果您的电脑配置非常强大，尝试 60 帧也是可以的，但请务必不要开启「无限帧率」哦。&#10;&#10;2. 释放电脑性能：自动战斗功能依托于 AI 视觉识别技术，需要消耗一定的计算资源。建议您在使用时尽量关闭不必要的后台程序，电脑运行越流畅，AI 的表现也会越出色。&#10;&#10;3. 截图间隔设置：为了不让 AI 错过每一个精彩瞬间，请确保截图频率至少达到每秒 20 次。毕竟，我们不能强求 AI 在 1 帧的画面里完成电竞级的操作呀。&#10;&#10;4. 按键设置建议：强烈建议您将连携技的「左」、「右」和「取消」设置为独立的按键，避免与普攻、闪避或终结技共用键位。特别需要强调的是，几乎所有的连携技释放错误都源自于使用了同一个按键。默认键位下，连携技出现时很容易被普攻误触，导致操作失误，分开设置会让战斗更精准。&#10;&#10;比如把连携左设置为1，连携右设置为3，取消设置为2&#10;&#10;5. 应对特殊情况：目前的 AI 还在学习中，暂时无法完美应对 BOSS 的转阶段或特殊状态攻击。遇到这种情况时，可能需要您稍微费心，暂停自动战斗并手动应对一下。&#10;&#10;6. 最佳显示环境：为了保证识别准确，请将游戏分辨率设置为 1920x1080，并关闭 HDR 功能。同时，请确保游戏画面没有被其他窗口遮挡，让 AI 能看清全局。&#10;&#10;祝您游戏愉快！" />
      </ScrollViewer>
    </fa:FAContentDialog>
  </Grid>
</UserControl>
