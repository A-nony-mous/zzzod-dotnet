<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:ZzzOd.Gui.PageModels.GameAssistant"
             x:Class="ZzzOd.Gui.Views.FrontierPages.GameAssistant.FrontierBattleAssistantSettings"
             x:DataType="local:ZzzBattleAssistantSettingsViewModel">
  <UserControl.Styles>
    <Style Selector="ItemsControl.zzz-settings-list fa|FASettingsExpanderItem">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left" Margin="16,0,0,0">
        <fa:FAInfoBar x:Name="SettingsErrorBar"
                    IsOpen="{Binding HasError}"
                    Message="{Binding LastError}"
                    IsClosable="False"
                    Severity="Error" />
        <StackPanel Spacing="8">
          <Border HorizontalAlignment="Left"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="{DynamicResource ExpanderHeaderBorderThickness}"
                  CornerRadius="{DynamicResource ControlCornerRadius}"
                  ClipToBounds="True">
            <StackPanel Orientation="Horizontal" Spacing="0">
              <ToggleButton x:Name="AutoBattleModeButton"
                            Classes="zzz-segmented-button"
                            Content="自动战斗"
                            IsChecked="True"
                            Click="OnAutoBattleModeClicked" />
              <ToggleButton x:Name="DodgeAssistantModeButton"
                            Classes="zzz-segmented-button"
                            Content="闪避助手"
                            Click="OnDodgeAssistantModeClicked" />
            </StackPanel>
          </Border>
          <Border x:Name="AutoBattleSettingsPanel"
                  Background="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="{DynamicResource ExpanderHeaderBorderThickness}"
                  CornerRadius="{DynamicResource ControlCornerRadius}"
                  ClipToBounds="True">
          <ItemsControl Classes="zzz-settings-list">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
              <fa:FASettingsExpanderItem Content="使用说明"
                                          Description="先看说明 再使用与提问">
                <fa:FASettingsExpanderItem.IconSource>
                  <fa:FAFontIconSource Glyph="&#xE897;" />
                </fa:FASettingsExpanderItem.IconSource>
                <fa:FASettingsExpanderItem.Footer>
              <fa:FACommandBar x:Name="HelpCommandBar"
                             DefaultLabelPosition="Right"
                             IsDynamicOverflowEnabled="False"
                             OverflowButtonVisibility="Collapsed">
                <fa:FACommandBar.PrimaryCommands>
                  <fa:FACommandBarButton Label="如何让AI打得更好？"
                                       Click="OnHelpClicked" />
                  <fa:FACommandBarButton Label="查看指南"
                                       Click="OnGuideClicked" />
                  <fa:FACommandBarButton Label="前往社区"
                                       Click="OnCommunityClicked" />
                </fa:FACommandBar.PrimaryCommands>
              </fa:FACommandBar>
                </fa:FASettingsExpanderItem.Footer>
              </fa:FASettingsExpanderItem>
              <fa:FASettingsExpanderItem Content="战斗配置"
                                          Description="全配队通用会自动为您的队伍匹配专属配队，遇到问题请反馈。">
                <fa:FASettingsExpanderItem.IconSource>
                  <fa:FAFontIconSource Glyph="&#xE7FC;" />
                </fa:FASettingsExpanderItem.IconSource>
                <fa:FASettingsExpanderItem.Footer>
                  <StackPanel Orientation="Horizontal"
                              Spacing="8">
                    <fa:FAComboBox x:Name="AutoBattleConfigCombo"
                                   Width="120"
                                   ItemsSource="{Binding AutoBattleOptions}"
                                   SelectedItem="{Binding SelectedAutoBattleConfig, Mode=TwoWay}"
                                   IsEnabled="{Binding BattleValuesAvailable}" />
                    <fa:FACommandBarButton x:Name="DeleteAutoBattleConfigButton"
                                         Width="40"
                                         Label=""
                                         AutomationProperties.Name="删除战斗配置"
                                         IsEnabled="{Binding CanDeleteAutoBattleConfig}"
                                         Click="OnDeleteAutoBattleConfigClicked">
                      <fa:FACommandBarButton.IconSource>
                        <fa:FASymbolIconSource Symbol="Delete" />
                      </fa:FACommandBarButton.IconSource>
                    </fa:FACommandBarButton>
                  </StackPanel>
                </fa:FASettingsExpanderItem.Footer>
              </fa:FASettingsExpanderItem>
              <fa:FASettingsExpanderItem Content="终结技一好就放"
                                           Description="终结技无视时机立刻释放">
                <fa:FASettingsExpanderItem.IconSource>
                  <fa:FAFontIconSource Glyph="&#xE7FC;" />
                </fa:FASettingsExpanderItem.IconSource>
                <fa:FASettingsExpanderItem.Footer>
                  <ToggleSwitch x:Name="AutoUltimateToggle"
                                OnContent="开"
                                OffContent="关"
                                IsChecked="{Binding AutoUltimateEnabled, Mode=TwoWay}"
                                IsEnabled="{Binding BattleValuesAvailable}" />
                </fa:FASettingsExpanderItem.Footer>
              </fa:FASettingsExpanderItem>
          </ItemsControl>
          </Border>
          <Border x:Name="DodgeAssistantSettingsPanel"
                  Background="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="{DynamicResource ExpanderHeaderBorderThickness}"
                  CornerRadius="{DynamicResource ControlCornerRadius}"
                  ClipToBounds="True"
                  IsVisible="False">
          <ItemsControl Classes="zzz-settings-list">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <fa:FASettingsExpanderItem Content="闪避方式"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top">
              <fa:FASettingsExpanderItem.IconSource>
                <fa:FAFontIconSource Glyph="&#xE7FC;" />
              </fa:FASettingsExpanderItem.IconSource>
              <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <fa:FAComboBox x:Name="DodgeConfigCombo"
                                 Width="120"
                                 ItemsSource="{Binding DodgeOptions}"
                                 SelectedItem="{Binding SelectedDodgeConfig, Mode=TwoWay}"
                                 IsEnabled="{Binding BattleValuesAvailable}" />
                  <fa:FACommandBarButton x:Name="DeleteDodgeConfigButton"
                                       Width="40"
                                       Label=""
                                        AutomationProperties.Name="删除闪避配置"
                                       IsEnabled="{Binding CanDeleteDodgeConfig}"
                                       Click="OnDeleteDodgeConfigClicked">
                    <fa:FACommandBarButton.IconSource>
                      <fa:FASymbolIconSource Symbol="Delete" />
                    </fa:FACommandBarButton.IconSource>
                  </fa:FACommandBarButton>
                </StackPanel>
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>
          </ItemsControl>
          </Border>
        </StackPanel>
        <Border Background="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="{DynamicResource ExpanderHeaderBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                ClipToBounds="True">
        <ItemsControl Classes="zzz-settings-list">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        <fa:FASettingsExpanderItem Content="GPU运算"
                                     Description="游戏画面掉帧的话 可以不启用">
          <fa:FASettingsExpanderItem.IconSource>
            <fa:FAFontIconSource Glyph="&#xE7FC;" />
          </fa:FASettingsExpanderItem.IconSource>
          <fa:FASettingsExpanderItem.Footer>
            <ToggleSwitch x:Name="GpuToggle"
                          OnContent="开"
                          OffContent="关"
                          IsChecked="{Binding FlashClassifierGpu, Mode=TwoWay}"
                          IsEnabled="{Binding ModelValuesAvailable}" />
          </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Content="截图间隔 (秒)"
                                     Description="一般默认0.02，除非电脑很卡。优先通过设置游戏30帧和低画质给AI留算力">
          <fa:FASettingsExpanderItem.IconSource>
            <fa:FAFontIconSource Glyph="&#xE823;" />
          </fa:FASettingsExpanderItem.IconSource>
          <fa:FASettingsExpanderItem.Footer>
            <fa:FANumberBox x:Name="ScreenshotIntervalNumber"
                          Minimum="0.02"
                          Maximum="0.1"
                          SmallChange="0.01"
                          SpinButtonPlacementMode="Inline"
                          Width="140"
                          Value="{Binding ScreenshotInterval, Mode=TwoWay}"
                          IsEnabled="{Binding BattleValuesAvailable}" />
          </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Content="操作方式"
                                     Description="仅影响自动战斗。如需使用手柄，请先安装虚拟手柄依赖。">
          <fa:FASettingsExpanderItem.IconSource>
            <fa:FAFontIconSource Glyph="&#xE7FC;" />
          </fa:FASettingsExpanderItem.IconSource>
          <fa:FASettingsExpanderItem.Footer>
            <fa:FAComboBox x:Name="ControlMethodCombo"
                           Width="72"
                           ItemsSource="{Binding ControlMethodOptions}"
                           SelectedItem="{Binding SelectedControlMethod, Mode=TwoWay}"
                           IsEnabled="{Binding BattleValuesAvailable}" />
          </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>
        </ItemsControl>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <fa:FAContentDialog x:Name="BattleHelpDialog"
                      Title="使用说明"
                      CloseButtonText="确认"
                      DefaultButton="Close">
      <ScrollViewer MaxHeight="620"
                    MaxWidth="760">
        <TextBlock TextWrapping="Wrap"
                   Text="为了让您的自动战斗体验更加顺畅，这里有一些温馨的小建议给到您：&#10;&#10;1. 关于画面设置：建议您将游戏帧数限制在 30 帧，并适当降低画质设置。如果您的电脑配置非常强大，尝试 60 帧也是可以的，但请务必不要开启「无限帧率」哦。&#10;&#10;2. 释放电脑性能：自动战斗功能依托于 AI 视觉识别技术，需要消耗一定的计算资源。建议您在使用时尽量关闭不必要的后台程序，电脑运行越流畅，AI 的表现也会越出色。&#10;&#10;3. 截图间隔设置：为了不让 AI 错过每一个精彩瞬间，请确保截图频率至少达到每秒 20 次。毕竟，我们不能强求 AI 在 1 帧的画面里完成电竞级的操作呀。&#10;&#10;4. 按键设置建议：强烈建议您将连携技的「左」、「右」和「取消」设置为独立的按键，避免与普攻、闪避或终结技共用键位。特别需要强调的是，几乎所有的连携技释放错误都源自于使用了同一个按键。默认键位下，连携技出现时很容易被普攻误触，导致操作失误，分开设置会让战斗更精准。&#10;&#10;比如把连携左设置为1，连携右设置为3，取消设置为2&#10;&#10;5. 应对特殊情况：目前的 AI 还在学习中，暂时无法完美应对 BOSS 的转阶段或特殊状态攻击。遇到这种情况时，可能需要您稍微费心，暂停自动战斗并手动应对一下。&#10;&#10;6. 最佳显示环境：为了保证识别准确，请将游戏分辨率设置为 1920x1080，并关闭 HDR 功能。同时，请确保游戏画面没有被其他窗口遮挡，让 AI 能看清全局。&#10;&#10;祝您游戏愉快！" />
      </ScrollViewer>
    </fa:FAContentDialog>
  </Grid>
</UserControl>
