<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:model="using:ZzzOd.Gui.PageModels.ApplicationSettings"
             x:Class="ZzzOd.Gui.Views.FrontierPages.ApplicationSettings.FrontierDriveDiscDismantleSettingsFlyoutContent"
             x:DataType="model:ZzzDriveDiscDismantleSettingsViewModel"
             MinWidth="420">
  <StackPanel Margin="8" Spacing="1">
    <fa:FAInfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" />
    <fa:FASettingsExpander Header="拆解等级">
      <fa:FASettingsExpander.Footer>
        <fa:FAComboBox x:Name="LevelCombo"
                       Width="180"
                       ItemsSource="{Binding LevelOptions}"
                       SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" />
      </fa:FASettingsExpander.Footer>
    </fa:FASettingsExpander>
    <fa:FASettingsExpander Header="全部已弃置">
      <fa:FASettingsExpander.Footer>
        <ToggleSwitch x:Name="AbandonToggle"
                      IsChecked="{Binding DismantleAbandon, Mode=TwoWay}" />
      </fa:FASettingsExpander.Footer>
    </fa:FASettingsExpander>
  </StackPanel>
</UserControl>
