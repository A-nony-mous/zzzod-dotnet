<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:ZzzOd.Gui.Views.FrontierPages.ApplicationSettings"
             x:Class="ZzzOd.Gui.Views.FrontierPages.ApplicationSettings.FrontierSuibianTempleAppSettingPage"
             x:DataType="local:ZzzSuibianTempleAppSettingViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{DynamicResource SampleAppPageMargin}"
                Spacing="{DynamicResource SampleAppSectionSpacing}">
      <fa:FAInfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" />
      <fa:FASettingsExpander Header="自动托管"
                               Description="启用后选择游戏内自动托管经营随便观相关任务，随便观35级后可用">
        <fa:FASettingsExpander.Footer>
                               <ToggleSwitch x:Name="AutoManageToggle"
                                             IsChecked="{Binding AutoManageEnabled, Mode=TwoWay}" />
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
      <fa:FASettingsExpander x:Name="YumChaItem" Header="饮茶仙" IsVisible="{Binding ManualSettingsVisible}">
        <fa:FASettingsExpander.Footer><ToggleSwitch x:Name="YumChaToggle" IsChecked="{Binding YumChaSin, Mode=TwoWay}" /></fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
      <fa:FASettingsExpander x:Name="YumChaRefreshItem" Header="饮茶仙-委托刷新" IsVisible="{Binding ManualSettingsVisible}">
        <fa:FASettingsExpander.Footer><ToggleSwitch x:Name="YumChaRefreshToggle" IsChecked="{Binding YumChaRefresh, Mode=TwoWay}" /></fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
      <fa:FASettingsExpander x:Name="AdventureDurationItem" Header="派遣-时长" IsVisible="{Binding ManualSettingsVisible}">
        <fa:FASettingsExpander.Footer><fa:FAComboBox x:Name="AdventureDurationCombo" Width="180" ItemsSource="{Binding AdventureDurationOptions}" SelectedItem="{Binding SelectedAdventureDuration, Mode=TwoWay}" /></fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
      <fa:FASettingsExpander x:Name="AdventureMissionItem" Header="派遣-副本优先级" Description="按优先级将剩余小队派遣" IsVisible="{Binding ManualSettingsVisible}">
        <fa:FASettingsExpander.Footer>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <fa:FAComboBox x:Name="AdventureMission1Combo" Width="150" ItemsSource="{Binding AdventureMissionOptions}" SelectedItem="{Binding SelectedAdventureMission1, Mode=TwoWay}" />
            <fa:FAComboBox x:Name="AdventureMission2Combo" Width="150" ItemsSource="{Binding AdventureMissionOptions}" SelectedItem="{Binding SelectedAdventureMission2, Mode=TwoWay}" />
            <fa:FAComboBox x:Name="AdventureMission3Combo" Width="150" ItemsSource="{Binding AdventureMissionOptions}" SelectedItem="{Binding SelectedAdventureMission3, Mode=TwoWay}" />
            <fa:FAComboBox x:Name="AdventureMission4Combo" Width="150" ItemsSource="{Binding AdventureMissionOptions}" SelectedItem="{Binding SelectedAdventureMission4, Mode=TwoWay}" />
          </StackPanel>
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
      <fa:FASettingsExpander x:Name="CraftDragItem" Header="制造坊-最大下拉次数" Description="跳过底部的低级商品" IsVisible="{Binding ManualSettingsVisible}">
        <fa:FASettingsExpander.Footer><fa:FANumberBox x:Name="CraftDragNumber" Minimum="0" Maximum="99" SmallChange="1" Value="{Binding CraftDragTimes, Mode=TwoWay}" /></fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
      <fa:FASettingsExpander Header="好物铺购买" Description="自动购买好物铺中的指定商品" IsVisible="{Binding ManualSettingsVisible}">
        <fa:FASettingsExpander.Footer><ToggleSwitch x:Name="GoodGoodsToggle" IsChecked="{Binding GoodGoodsPurchaseEnabled, Mode=TwoWay}" /></fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
      <fa:FASettingsExpander Header="邦巢-购买" Description="自动刷新购买S级别邦布。随便观25级后可用。" IsVisible="{Binding ManualSettingsVisible}">
        <fa:FASettingsExpander.Footer><ToggleSwitch x:Name="BooBoxToggle" IsChecked="{Binding BooBoxPurchaseEnabled, Mode=TwoWay}" /></fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
      <fa:FASettingsExpander Header="邦巢-最低购买价格" IsVisible="{Binding ManualSettingsVisible}">
        <fa:FASettingsExpander.Footer>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="游历" />
            <fa:FAComboBox x:Name="BooBoxAdventureCombo" Width="110" ItemsSource="{Binding BooBoxPriceOptions}" SelectedItem="{Binding SelectedBooBoxAdventurePrice, Mode=TwoWay}" />
            <TextBlock VerticalAlignment="Center" Text="制造" />
            <fa:FAComboBox x:Name="BooBoxCraftCombo" Width="110" ItemsSource="{Binding BooBoxPriceOptions}" SelectedItem="{Binding SelectedBooBoxCraftPrice, Mode=TwoWay}" />
            <TextBlock VerticalAlignment="Center" Text="售卖" />
            <fa:FAComboBox x:Name="BooBoxSellCombo" Width="110" ItemsSource="{Binding BooBoxPriceOptions}" SelectedItem="{Binding SelectedBooBoxSellPrice, Mode=TwoWay}" />
          </StackPanel>
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
