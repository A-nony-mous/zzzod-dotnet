<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:accounts="using:ZzzOd.Gui.Pages.Accounts"
             x:Class="ZzzOd.Gui.Views.FrontierPages.Accounts.ZzzFrontierAccountsPage">
  <Grid>
    <ScrollViewer Padding="{DynamicResource SampleAppPageMargin}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="{DynamicResource SampleAppSectionSpacing}">
        <Grid x:Name="HeaderGrid"
              Margin="{DynamicResource SampleAppHeaderMargin}"
              ColumnDefinitions="*,Auto">
          <DockPanel Grid.Column="0">
            <fa:FASymbolIcon Symbol="People"
                             FontSize="32"
                             DockPanel.Dock="Left"
                             VerticalAlignment="Center" />
            <TextBlock Margin="12,0,0,0"
                       Text="账户管理"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </DockPanel>
          <Button x:Name="AddInstanceButton"
                  Grid.Column="1"
                  Content="新增"
                  MinWidth="100"
                  VerticalAlignment="Center"
                  Click="OnAddInstanceClicked" />
        </Grid>

        <fa:FAInfoBar x:Name="ActionBar"
                      IsOpen="False"
                      IsClosable="True" />

        <fa:FASettingsExpander Header="使用说明"
                               Description="点击启用后到各模块进行设置，各账户之间的设置是独立的。">
          <fa:FASettingsExpander.IconSource>
            <fa:FASymbolIconSource Symbol="Help" />
          </fa:FASettingsExpander.IconSource>
          <fa:FASettingsExpander.Footer>
            <Button Content="查看"
                    Click="OnHelpClicked" />
          </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>

        <fa:FASettingsExpander Header="当前账户设置"
                               IsExpanded="True">
          <fa:FASettingsExpander.IconSource>
            <fa:FASymbolIconSource Symbol="Contact" />
          </fa:FASettingsExpander.IconSource>

          <fa:FASettingsExpanderItem x:Name="GamePathItem"
                                     Content="游戏路径">
            <fa:FASettingsExpanderItem.IconSource>
              <fa:FASymbolIconSource Symbol="Folder" />
            </fa:FASettingsExpanderItem.IconSource>
            <fa:FASettingsExpanderItem.Footer>
              <Button Content="选择"
                      Click="OnChooseGamePathClicked" />
            </fa:FASettingsExpanderItem.Footer>
          </fa:FASettingsExpanderItem>

          <fa:FASettingsExpanderItem Content="自定义窗口标题">
            <fa:FASettingsExpanderItem.IconSource>
              <fa:FASymbolIconSource Symbol="FullScreen" />
            </fa:FASettingsExpanderItem.IconSource>
            <fa:FASettingsExpanderItem.Footer>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBox x:Name="CustomWindowTitleInput"
                         Width="214"
                         LostFocus="OnCustomWindowTitleLostFocus" />
                <ToggleSwitch x:Name="UseCustomWindowTitleToggle"
                              OnContent=""
                              OffContent=""
                              Click="OnUseCustomWindowTitleChanged" />
              </StackPanel>
            </fa:FASettingsExpanderItem.Footer>
          </fa:FASettingsExpanderItem>

          <fa:FASettingsExpanderItem Content="游戏区服">
            <fa:FASettingsExpanderItem.IconSource>
              <fa:FASymbolIconSource Symbol="Home" />
            </fa:FASettingsExpanderItem.IconSource>
            <fa:FASettingsExpanderItem.Footer>
              <fa:FAComboBox x:Name="GameRegionCombo"
                             Width="180"
                             SelectionChanged="OnGameRegionChanged">
                <fa:FAComboBox.ItemTemplate>
                  <DataTemplate x:DataType="accounts:ZzzAccountOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </fa:FAComboBox.ItemTemplate>
              </fa:FAComboBox>
            </fa:FASettingsExpanderItem.Footer>
          </fa:FASettingsExpanderItem>

          <fa:FASettingsExpanderItem x:Name="AccountItem"
                                     Content="账号"
                                     Description="所有信息都明文保存在本地">
            <fa:FASettingsExpanderItem.IconSource>
              <fa:FASymbolIconSource Symbol="People" />
            </fa:FASettingsExpanderItem.IconSource>
            <fa:FASettingsExpanderItem.Footer>
              <TextBox x:Name="AccountInput"
                       Width="260"
                       LostFocus="OnAccountLostFocus" />
            </fa:FASettingsExpanderItem.Footer>
          </fa:FASettingsExpanderItem>

          <fa:FASettingsExpanderItem x:Name="PasswordItem"
                                     Content="密码"
                                     Description="请自行妥善管理">
            <fa:FASettingsExpanderItem.IconSource>
              <fa:FASymbolIconSource Symbol="Permissions" />
            </fa:FASettingsExpanderItem.IconSource>
            <fa:FASettingsExpanderItem.Footer>
              <TextBox x:Name="PasswordInput"
                       Width="260"
                       PasswordChar="●"
                       LostFocus="OnPasswordLostFocus" />
            </fa:FASettingsExpanderItem.Footer>
          </fa:FASettingsExpanderItem>

          <fa:FASettingsExpanderItem x:Name="BilibiliHelpItem"
                                     Content="B服使用提示"
                                     Description="B服请在『设置 - 脚本环境 - 基础』中设置截图方法为BitBit，否则可能无法识别登录框。"
                                     IsVisible="False">
            <fa:FASettingsExpanderItem.IconSource>
              <fa:FASymbolIconSource Symbol="Important" />
            </fa:FASettingsExpanderItem.IconSource>
          </fa:FASettingsExpanderItem>

          <fa:FASettingsExpanderItem x:Name="BilibiliAccountItem"
                                     Content="B服用户名"
                                     Description="B服为选择已有登录记录的用户进行登录，需要先手动登录游戏"
                                     IsVisible="False">
            <fa:FASettingsExpanderItem.IconSource>
              <fa:FASymbolIconSource Symbol="People" />
            </fa:FASettingsExpanderItem.IconSource>
            <fa:FASettingsExpanderItem.Footer>
              <TextBox x:Name="BilibiliAccountInput"
                       Width="300"
                       PlaceholderText="填写游戏中切换B服账号时显示的用户名"
                       LostFocus="OnBilibiliAccountLostFocus" />
            </fa:FASettingsExpanderItem.Footer>
          </fa:FASettingsExpanderItem>
        </fa:FASettingsExpander>

        <fa:FASettingsExpander x:Name="InstanceList"
                               Header="账户列表"
                               IsExpanded="True">
          <fa:FASettingsExpander.IconSource>
            <fa:FASymbolIconSource Symbol="People" />
          </fa:FASettingsExpander.IconSource>
          <fa:FASettingsExpander.ItemTemplate>
            <DataTemplate x:DataType="accounts:ZzzAccountInstanceRow">
              <fa:FASettingsExpanderItem Content="{Binding DisplayIndex}">
                <fa:FASettingsExpanderItem.IconSource>
                  <fa:FASymbolIconSource Symbol="People" />
                </fa:FASettingsExpanderItem.IconSource>
                <fa:FASettingsExpanderItem.Footer>
                  <Grid ColumnDefinitions="120,8,180,8,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding Name, Mode=TwoWay}"
                             IsEnabled="{Binding CanEdit}"
                             TextChanged="OnInstanceNameChanged" />
                    <fa:FAComboBox Grid.Column="2"
                                   ItemsSource="{Binding RunOptions}"
                                   SelectedItem="{Binding SelectedRunOption, Mode=TwoWay}"
                                   IsEnabled="{Binding CanEdit}"
                                   SelectionChanged="OnInstanceRunChanged">
                      <fa:FAComboBox.ItemTemplate>
                        <DataTemplate x:DataType="accounts:ZzzAccountRunOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </fa:FAComboBox.ItemTemplate>
                    </fa:FAComboBox>
                    <fa:FACommandBar Grid.Column="4"
                                     DefaultLabelPosition="Right">
                      <fa:FACommandBar.PrimaryCommands>
                        <fa:FACommandBarButton Label="启用"
                                               IsEnabled="{Binding CanActivate}"
                                               Click="OnActivateInstanceClicked" />
                        <fa:FACommandBarButton Label="登录"
                                               IsEnabled="{Binding CanEdit}"
                                               Click="OnLoginInstanceClicked" />
                        <fa:FACommandBarButton Label="删除"
                                               IsEnabled="{Binding CanDelete}"
                                               Click="OnDeleteInstanceClicked">
                          <fa:FACommandBarButton.IconSource>
                            <fa:FASymbolIconSource Symbol="Delete" />
                          </fa:FACommandBarButton.IconSource>
                        </fa:FACommandBarButton>
                      </fa:FACommandBar.PrimaryCommands>
                    </fa:FACommandBar>
                  </Grid>
                </fa:FASettingsExpanderItem.Footer>
              </fa:FASettingsExpanderItem>
            </DataTemplate>
          </fa:FASettingsExpander.ItemTemplate>
        </fa:FASettingsExpander>
      </StackPanel>
    </ScrollViewer>

    <fa:FAContentDialog x:Name="ProtectionDialog"
                        Title="密码验证"
                        PrimaryButtonText="确定"
                        CloseButtonText="取消"
                        DefaultButton="Primary">
      <TextBox x:Name="ProtectionPasswordInput"
               Width="280"
               PlaceholderText="请输入密码"
               PasswordChar="●" />
    </fa:FAContentDialog>
  </Grid>
</UserControl>
