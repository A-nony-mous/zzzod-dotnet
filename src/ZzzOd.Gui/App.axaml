<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="ZzzOd.Gui.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ZzzOd.Gui/Theme/ZzzTypography.axaml" />
        <ResourceInclude Source="avares://ZzzOd.Gui/Theme/ZzzSpacing.axaml" />
        <ResourceInclude Source="avares://ZzzOd.Gui/Theme/ZzzFluentTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <sty:FluentAvaloniaTheme PreferSystemTheme="True"
                             PreferUserAccentColor="True" />
    <StyleInclude Source="avares://ZzzOd.Gui/Theme/ZzzComponentStyles.axaml" />
    <StyleInclude Source="avares://ZzzOd.Gui/Theme/ZzzPivotStyles.axaml" />
  </Application.Styles>
</Application>
