<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>ZzzOd.Gui</AssemblyName>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <RootNamespace />
    <NoWarn>$(NoWarn);CS0108</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZzzOd.Api\ZzzOd.Api.csproj" />
    <ProjectReference Include="..\ZzzOd.AppHost\ZzzOd.AppHost.csproj" />
    <ProjectReference Include="..\ZzzOd.GameLogic\ZzzOd.GameLogic.csproj" />
    <ProjectReference Include="..\..\..\od-dotnet\src\OneDragon.Core.Abstractions\OneDragon.Core.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\od-dotnet\src\OneDragon.Core\OneDragon.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.0" PrivateAssets="All" Publish="True" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" PrivateAssets="All" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <Target Name="SyncWorkspaceAssetsToBin" AfterTargets="Build">
    <PropertyGroup>
      <_WorkspaceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</_WorkspaceRoot>
    </PropertyGroup>
    <!-- assets 为静态真源，镜像同步：删除 bin 残留旧名、覆盖过期同名文件。
         config 只同步基线（auto_battle 等），实例目录 [0-9]* 与 app_run_record 属可变数据不覆盖。 -->
    <Exec Command="robocopy &quot;$(_WorkspaceRoot)\assets&quot; &quot;$(TargetDir)assets&quot; /MIR /XD .install uv_cache /NFL /NDL /NJH /NJS /NP /R:1 /W:1" IgnoreExitCode="true" />
    <Exec Command="robocopy &quot;$(_WorkspaceRoot)\config&quot; &quot;$(TargetDir)config&quot; /MIR /XD [0-9]* app_run_record /NFL /NDL /NJH /NJS /NP /R:1 /W:1" IgnoreExitCode="true" />
  </Target>
</Project>
