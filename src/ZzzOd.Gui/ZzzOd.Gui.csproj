<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>ZzzOd.Gui</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <RootNamespace />
    <NoWarn>$(NoWarn);CS0108</NoWarn>
    <HotAvalonia Condition="'$(HotAvalonia)' == ''">false</HotAvalonia>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <ProjectReference Include="..\ZzzOd.Api\ZzzOd.Api.csproj" />
    <ProjectReference Include="..\ZzzOd.AppHost\ZzzOd.AppHost.csproj" />
    <ProjectReference Include="..\ZzzOd.GameLogic\ZzzOd.GameLogic.csproj" />
    <ProjectReference Include="..\..\..\od-dotnet\src\OneDragon.Core.Abstractions\OneDragon.Core.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\od-dotnet\src\OneDragon.Core\OneDragon.Core.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.3.18" PrivateAssets="All" Publish="True" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.12" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.12" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.1" />
    <PackageReference Include="HotAvalonia" Version="3.1.3" PrivateAssets="All" Publish="True" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>
</Project>
