<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:notices="using:ZzzOd.Gui.Services.Notices"
             x:Class="ZzzOd.Gui.Controls.Home.ZzzNoticeCard"
             Width="589"
             Height="150">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="NoticePostTemplate"
                  x:DataType="notices:ZzzNoticePost">
      <Grid Height="26"
            Margin="12,0"
            ColumnDefinitions="*,64">
        <TextBlock VerticalAlignment="Center"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   Text="{Binding Title}" />
        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                   Text="{Binding Date}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border Classes="zzz-notice-card"
          ClipToBounds="True">
    <Grid ColumnDefinitions="225,*">
      <Image x:Name="BannerImage"
             Width="225"
             Height="150"
             Cursor="Hand"
             PointerReleased="OnBannerPointerReleased"
             Stretch="UniformToFill" />

      <Grid Grid.Column="1">
        <TabControl Classes="zzz-pivot" Background="Transparent"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    SelectedIndex="2">
          <TabItem Classes="zzz-pivot-item" Header="游戏攻略"
                          Background="Transparent">
            <ListBox x:Name="GameGuidesList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource NoticePostTemplate}"
                     SelectionChanged="OnPostSelectionChanged" />
          </TabItem>
          <TabItem Classes="zzz-pivot-item" Header="软件科研"
                          Background="Transparent">
            <ListBox x:Name="SoftwareResearchList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource NoticePostTemplate}"
                     SelectionChanged="OnPostSelectionChanged" />
          </TabItem>
          <TabItem Classes="zzz-pivot-item" Header="公告要闻"
                          Background="Transparent">
            <ListBox x:Name="AnnouncementsList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource NoticePostTemplate}"
                     SelectionChanged="OnPostSelectionChanged" />
          </TabItem>
        </TabControl>

        <fa:FAInfoBar x:Name="FailureInfoBar"
                    Margin="8"
                    VerticalAlignment="Bottom"
                    Severity="Warning"
                    Title="公告加载失败"
                    IsClosable="False"
                    IsOpen="False" />
        <Button x:Name="RetryButton"
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Content="重试"
                IsVisible="False"
                Click="OnRetryClicked" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
