<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="ZzzOd.Gui.Controls.ZzzRunPanel">
  <Grid>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
    <fa:InfoBar x:Name="RunErrorBar"
                Grid.Row="0" Margin="0,0,0,8"
                IsOpen="False"
                IsClosable="False"
                Severity="Error" />
    <TextBlock x:Name="StateText"
               Grid.Row="1" Margin="0,0,0,8"
               Text="当前状态 空闲"
               TextWrapping="Wrap" />
    <fa:FAComboBox x:Name="AppCombo"
                   Grid.Row="2" Margin="0,0,0,8"
                   MinWidth="260" />
    <Grid ColumnDefinitions="*,8,*" Grid.Row="3" Margin="0,0,0,8">
      <Button x:Name="PrimaryButton"
              Grid.Column="0"
              Classes="accent">
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <fa:SymbolIcon x:Name="PrimaryIcon"
                         Symbol="Play" />
          <TextBlock x:Name="PrimaryLabel"
                     Text="开始" />
        </StackPanel>
      </Button>
      <Button x:Name="StopButton"
              Grid.Column="2"
              IsEnabled="False">
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <fa:SymbolIcon Symbol="Cancel" />
          <TextBlock x:Name="StopLabel"
                     Text="停止" />
        </StackPanel>
      </Button>
    </Grid>
    <ContentControl x:Name="LogHost"
                    Grid.Row="4"
                    HorizontalContentAlignment="Stretch" />
  </Grid>
    <Border x:Name="RunOperationOverlay"
            Background="#66000000"
            IsVisible="False">
      <fa:ProgressRing Width="32"
                       Height="32"
                       IsActive="True"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
